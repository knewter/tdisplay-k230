# USB device mode for U-Boot's `ums`, appended to k230_canmv_v3_defconfig by
# nix/uboot-k230.nix. Read with docs/uboot-ums.md §3 and the design of
# openspec/changes/the-card-is-flashed-over-usb-from-u-boot.
#
# The gadget stack. These six lines are the diff between Canaan's own
# k230_canmv_burntool_defconfig -- a working USB-gadget configuration for
# this SoC in this same tree -- and the defconfig this board builds. The
# vendor/product pair is Canaan's, the one the K230 BootROM and the
# k230_flash host tools already enumerate as (docs/uboot-ums.md §5), so a
# udev rule written for that tool matches this gadget too.
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_GADGET_DWC2_OTG=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_VENDOR_NUM=0x29f1
CONFIG_USB_GADGET_PRODUCT_NUM=0x0230
# The command itself. cmd/Kconfig: depends on USB_GADGET_DOWNLOAD, BLK and
# USB_GADGET, selects USB_FUNCTION_MASS_STORAGE. Not CMD_DFU: that would
# also flip usbotg0 on (k230.dtsi guards its `status = "disabled"` with
# #ifndef CONFIG_CMD_DFU) but drags in DFU and, per arch/riscv/cpu/k230/
# cpu.c, removes the PMP entries locking the 0x91213000/0x91214000 window.
# The device-tree override in nix/patches/uboot-k230/ enables usbotg0
# instead, and says what it means.
CONFIG_CMD_USB_MASS_STORAGE=y
#
# USB *host* off, on purpose, and not because the symbol is in the way.
# In U-Boot 2022.10 the host driver U_BOOT_DRIVER(usb_dwc2) in
# drivers/usb/host/dwc2.c and the gadget driver U_BOOT_DRIVER(dwc2_udc_otg)
# in drivers/usb/gadget/dwc2_udc_otg.c both match compatible "snps,dwc2".
# lists_bind_fdt() (drivers/core/lists.c) binds the FIRST driver in the
# linker list whose of_match hits and stops; it only tries the next on
# -ENODEV from a .bind, and neither driver has a .bind. The gadget's
# dr_mode refusal is in dwc2_udc_otg_of_to_plat(), which runs at probe --
# too late. Linker-list entries sort by name and dwc2_udc_otg sorts before
# usb_dwc2, so with both enabled the gadget silently takes every snps,dwc2
# node, including usbotg1 and the onboard RTL8152 behind it, and USB host
# goes dark without a message. A declared loss is better than a silent one:
# nothing in bootcmd (`run blinux`, mmc only) uses USB host. Canaan reached
# the same conclusion -- k230_canmv_burntool_defconfig enables the gadget
# and drops CONFIG_USB_DWC2. Restoring both is design D3's follow-up: a
# .bind on the gadget driver that refuses nodes whose dr_mode is "host".
# Do not "fix" this line without that patch.
# CONFIG_USB_DWC2 is not set
