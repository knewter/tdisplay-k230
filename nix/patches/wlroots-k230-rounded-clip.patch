+void wlr_scene_buffer_set_rounded_clip(struct wlr_scene_buffer *buffer,
+		const struct wlr_box *box, int radius) {
+	struct wlr_box clip = box ? *box : (struct wlr_box){0};
+	if (wlr_box_empty(&clip)) clip = (struct wlr_box){0};
+	if (radius < 0) radius = 0;
+	if (radius > 256) radius = 256;
+	if (radius > clip.width / 2) radius = clip.width / 2;
+	if (radius > clip.height / 2) radius = clip.height / 2;
+	if (wlr_box_equal(&buffer->rounded_clip, &clip) && buffer->rounded_radius == radius) return;
+	buffer->rounded_clip = clip;
+	buffer->rounded_radius = radius;
+	scene_node_update(&buffer->node, NULL);
+}
