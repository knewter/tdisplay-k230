+		box.width - 2 * radius, box.height);
+	pixman_region32_union_rect(&interior, &interior, x + box.x, y + box.y + radius,
+		box.width, box.height - 2 * radius);
+	pixman_region32_intersect(opaque, opaque, &interior);
+	pixman_region32_fini(&interior);
