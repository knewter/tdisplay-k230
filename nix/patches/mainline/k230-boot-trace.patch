--- a/init/main.c
+++ b/init/main.c
@@ -1452,0 +1453,25 @@
+/* Optional K230 boot diagnosis. These objects survive free_initmem(). */
+static bool k230_boot_trace_enabled;
+static unsigned int k230_boot_trace_seq;
+
+static int __init k230_boot_trace_setup(char *str)
+{
+	if (strcmp(str, "1"))
+		return 0;
+	k230_boot_trace_enabled = true;
+	return 1;
+}
+__setup("k230.boot_trace=", k230_boot_trace_setup);
+
+static void k230_boot_trace_mark(const char *step)
+{
+	if (!k230_boot_trace_enabled || k230_boot_trace_seq >= 32)
+		return;
+
+	/* Never keep emergency state across the work being diagnosed. */
+	nbcon_cpu_emergency_enter();
+	pr_info("K230_BOOT_TRACE_V1 seq=%u step=%s\n",
+		++k230_boot_trace_seq, step);
+	nbcon_cpu_emergency_exit();
+}
+
@@ -1459,0 +1485 @@
+	k230_boot_trace_mark("initcalls-enter");
@@ -1460,0 +1487 @@
+	k230_boot_trace_mark("initcalls-exit");
@@ -1474,0 +1502 @@
+	int ret;
@@ -1484 +1512,4 @@
-	return kernel_execve(init_filename, argv_init, envp_init);
+	k230_boot_trace_mark("init-exec-enter");
+	ret = kernel_execve(init_filename, argv_init, envp_init);
+	k230_boot_trace_mark("init-exec-exit");
+	return ret;
@@ -1566,0 +1598 @@
+	k230_boot_trace_mark("async-wait-enter");
@@ -1568 +1600,3 @@
-
