+/* Mainline's <linux/if_pppox.h> restricts struct pppoe_hdr's "tag[]" and
+ * struct pppoe_tag's "tag_data[]" flexible-array members to userspace only
+ * (#ifndef __KERNEL__) -- confirmed directly against that uapi header at
+ * this pin. Both flexible arrays start exactly where their struct's fixed
+ * fields end, which is also exactly what pointer arithmetic one past a
+ * typed pointer gives (a flexible array member contributes 0 to sizeof()),
+ * so every former "ph->tag" / "tag->tag_data" use below becomes one of
+ * these two casts instead of patching the system header. */
+#define RTW_PPPOE_HDR_TAG(ph)   ((unsigned char *)((ph) + 1))
+#define RTW_PPPOE_TAG_DATA(tag) ((unsigned char *)((tag) + 1))
+
 #define MAGIC_CODE		0x8186
 #define MAGIC_CODE_LEN	2
 #define WAIT_TIME_PPPOE	5	/* waiting time for pppoe server in sec */
@@ -89,7 +100,7 @@ static __inline__ unsigned char *__nat25_find_pppoe_tag(struct pppoe_hdr *ph, un
 	unsigned char *cur_ptr, *start_ptr;
 	unsigned short tagLen, tagType;
 
-	start_ptr = cur_ptr = (unsigned char *)ph->tag;
+	start_ptr = cur_ptr = RTW_PPPOE_HDR_TAG(ph);
 	while ((cur_ptr - start_ptr) < ntohs(ph->length)) {
 		/* prevent un-alignment access */
 		tagType = (unsigned short)((cur_ptr[0] << 8) + cur_ptr[1]);
@@ -115,9 +126,9 @@ static __inline__ int __nat25_add_pppoe_tag(struct sk_buff *skb, struct pppoe_ta
 
 	skb_put(skb, data_len);
 	/* have a room for new tag */
-	memmove(((unsigned char *)ph->tag + data_len), (unsigned char *)ph->tag, ntohs(ph->length));
+	memmove((RTW_PPPOE_HDR_TAG(ph) + data_len), RTW_PPPOE_HDR_TAG(ph), ntohs(ph->length));
 	ph->length = htons(ntohs(ph->length) + data_len);
-	memcpy((unsigned char *)ph->tag, tag, data_len);
+	memcpy(RTW_PPPOE_HDR_TAG(ph), tag, data_len);
 	return data_len;
 }
 
@@ -1146,8 +1157,8 @@ int nat25_db_handle(_adapter *priv, struct sk_buff *skb, int method)
 								return -1;
 							}
 
-							memcpy(tag->tag_data + MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN,
-							       pOldTag->tag_data, old_tag_len);
+							memcpy(RTW_PPPOE_TAG_DATA(tag) + MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN,
+							       RTW_PPPOE_TAG_DATA(pOldTag), old_tag_len);
 
