+++ b/include/osdep_service_linux.h
@@ -362,6 +362,19 @@ __inline static _list	*get_list_head(_queue	*queue)
 	return &(queue->queue);
 }
 
+/* Mainline v7.3-rc5 renamed these two timer-API primitives (confirmed
+ * directly against include/linux/timer.h at this pin: from_timer() is now
+ * timer_container_of(), same argument order; del_timer_sync() is now
+ * timer_delete_sync(), same signature). The #ifndef guards make this a
+ * no-op on any kernel that still provides the old names. */
+#ifndef from_timer
+#define from_timer(var, callback_timer, timer_fieldname) \
+	timer_container_of(var, callback_timer, timer_fieldname)
+#endif
+#ifndef del_timer_sync
+#define del_timer_sync(timer) timer_delete_sync(timer)
+#endif
+
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 14, 0))
 static inline void timer_hdl(struct timer_list *in_timer)
 #else
diff --git a/os_dep/linux/ioctl_linux.c b/os_dep/linux/ioctl_linux.c
index 376d770..5498b13 100644
--- a/os_dep/linux/ioctl_linux.c
+++ b/os_dep/linux/ioctl_linux.c
@@ -3145,7 +3145,21 @@ static int rtw_wx_set_enc_ext(struct net_device *dev,
 		goto exit;
 	}
 
-	strncpy((char *)param->u.crypt.alg, alg_name, IEEE_CRYPT_ALG_NAME_LEN);
+	/* Mainline v7.3-rc5 dropped strncpy()'s declaration from
+	 * include/linux/string.h entirely (it is no longer even exported to
+	 * modules -- confirmed directly, grep finds no declaration and no
+	 * Module.symvers entry at this pin). strscpy() with the same explicit
+	 * size argument is the documented replacement; it always
+	 * NUL-terminates (strncpy did not, if alg_name were ever >= the
+	 * buffer size) and alg_name here is always one of a few short
+	 * constant algorithm-name literals, well under
+	 * IEEE_CRYPT_ALG_NAME_LEN, so there is no truncation-behavior change.
+	 * The one real difference -- strscpy does not zero-pad unused
+	 * trailing bytes the way strncpy did -- does not matter here; this
+	 * field is read back by strcmp()/strcmp()-style comparisons against
+	 * NUL-terminated literals elsewhere in this file, never memcmp'd in
+	 * full width. */
+	strscpy((char *)param->u.crypt.alg, alg_name, IEEE_CRYPT_ALG_NAME_LEN);
 
 	if (pext->ext_flags & IW_ENCODE_EXT_SET_TX_KEY)
 		param->u.crypt.set_tx = 1;
