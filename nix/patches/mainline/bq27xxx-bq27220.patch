Add the TI BQ27220 fuel gauge to bq27xxx (keyboard-base task 5.1).

The LILYGO keyboard base carries a BQ27220 at 0x55 on I2C4. Mainline
bq27xxx at our pin has no entry for it. This adds one using the standard
commands in TI's BQ27220 TRM (SLUUBD4), the same addresses LILYGO's
ui_hardware.c reads. dm_regs is NULL, so the driver never writes the
gauge's data memory; it only reads standard commands.

--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -36,6 +36,7 @@
  * https://www.ti.com/product/bq27411-g1
  * https://www.ti.com/product/bq27441-g1
  * https://www.ti.com/product/bq27621-g1
+ * https://www.ti.com/product/bq27220
  * https://www.ti.com/product/bq27z561
  * https://www.ti.com/product/bq28z610
  * https://www.ti.com/product/bq34z100-g1
@@ -563,6 +564,34 @@
 		[BQ27XXX_REG_DCAP] = 0x3c,
 		[BQ27XXX_REG_AP] = 0x22,
 		BQ27XXX_DM_REG_ROWS,
+	},
+	/*
+	 * Standard commands from the BQ27220 TRM (SLUUBD4). CURRENT_NOW reads
+	 * Current (0x0C) rather than AverageCurrent (0x14). BatteryStatus
+	 * keeps the generic layout the driver already decodes: DSG is bit 0,
+	 * SYSDWN and TDA (bits 1 and 2) take the SOCF/SOC1 low-charge
+	 * meaning, and FC is bit 9.
+	 */
+	bq27220_regs[BQ27XXX_REG_MAX] = {
+		[BQ27XXX_REG_CTRL] = 0x00,
+		[BQ27XXX_REG_TEMP] = 0x06,
+		[BQ27XXX_REG_INT_TEMP] = 0x28,
+		[BQ27XXX_REG_VOLT] = 0x08,
+		[BQ27XXX_REG_AI] = 0x0c,
+		[BQ27XXX_REG_FLAGS] = 0x0a,
+		[BQ27XXX_REG_TTE] = 0x16,
+		[BQ27XXX_REG_TTF] = 0x18,
+		[BQ27XXX_REG_TTES] = 0x1c,
+		[BQ27XXX_REG_TTECP] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_NAC] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_RC] = 0x10,
+		[BQ27XXX_REG_FCC] = 0x12,
+		[BQ27XXX_REG_CYCT] = 0x2a,
+		[BQ27XXX_REG_AE] = INVALID_REG_ADDR,
+		[BQ27XXX_REG_SOC] = 0x2c,
+		[BQ27XXX_REG_DCAP] = 0x3c,
+		[BQ27XXX_REG_AP] = 0x24,
+		BQ27XXX_DM_REG_ROWS,
 	};
 
 static enum power_supply_property bq27000_props[] = {
@@ -878,6 +907,26 @@
 	POWER_SUPPLY_PROP_MANUFACTURER,
 };
 
