+/* The optional DRM DT supplies core, bus, axi, block and timer clocks. */
+static int dwcmshc_enable_clks(struct sdhci_pltfm_host *pltfm_host,
+                             struct dwcmshc_priv *priv)
+{
+	int ret;
+
+	ret = clk_prepare_enable(pltfm_host->clk);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(priv->bus_clk);
+	if (ret)
+		goto disable_core;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(priv->extra_clks), priv->extra_clks);
+	if (ret)
+		goto disable_bus;
+
+	return 0;
+
+disable_bus:
+	clk_disable_unprepare(priv->bus_clk);
+disable_core:
+	clk_disable_unprepare(pltfm_host->clk);
+	return ret;
+}
+
+static void dwcmshc_disable_clks(struct sdhci_pltfm_host *pltfm_host,
+                               struct dwcmshc_priv *priv)
+{
+	clk_bulk_disable_unprepare(ARRAY_SIZE(priv->extra_clks), priv->extra_clks);
+	clk_disable_unprepare(priv->bus_clk);
+	clk_disable_unprepare(pltfm_host->clk);
+}
