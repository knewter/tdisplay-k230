@@ -2,0 +3,2 @@
+#include <linux/atomic.h>
+#include <linux/completion.h>
@@ -76,0 +79,52 @@
+/* Memory mode is an intervention: no worker output, one observer summary. */
+static bool k230_uart_progress_memory_enabled;
+static atomic_t k230_uart_progress_memory_state = ATOMIC_INIT(0);
+static DECLARE_COMPLETION(k230_uart_progress_memory_done);
+static char k230_uart_progress_memory_record[256] __aligned(256);
+
+static bool k230_uart_progress_memory_active(void)
+{
+	return IS_ENABLED(CONFIG_RISCV_SBI) && k230_uart_progress_enabled &&
+		k230_uart_progress_memory_enabled && sbi_debug_console_available;
+}
+
+/* One coherent publication: stage[2:0], current index[5:3], bitmap[11:6]. */
+static void k230_uart_progress_memory_publish(unsigned int stage,
+					    unsigned int sample, unsigned int done)
+{
+	atomic_set_release(&k230_uart_progress_memory_state,
+			   stage | (sample << 3) | (done << 6));
+}
+
+static int k230_uart_progress_memory_observer(void *unused)
+{
+	unsigned long waited;
+	unsigned int state, stage, sample, done, last = 6, i;
+	int length;
+	(void)unused;
+	/* One wait and one acquire read; no seqcount polling or retry. */
+	waited = wait_for_completion_timeout(&k230_uart_progress_memory_done,
+					     msecs_to_jiffies(45000));
+	state = atomic_read_acquire(&k230_uart_progress_memory_state);
+	stage = state & 7;
+	sample = (state >> 3) & 7;
+	done = (state >> 6) & 63;
+	for (i = 0; i < K230_UP_SAMPLES; i++)
+		if (done & (1U << i))
+			last = i;
+	length = snprintf(k230_uart_progress_memory_record,
+			  sizeof(k230_uart_progress_memory_record),
+			  "\nK230_UMP1 s=%u n=%u m=%02x l=%u w=%u\n",
+			  stage, sample, done, last, waited ? 1U : 0U);
+	if (length > 0 && (size_t)length < sizeof(k230_uart_progress_memory_record))
+		(void)sbi_debug_console_write(k230_uart_progress_memory_record, length);
+	return 0;
+}
+
+static int __init k230_uart_progress_memory_setup(char *value)
+{
+	k230_uart_progress_memory_enabled = value && !strcmp(value, "1");
+	return 1;
+}
+__setup("k230.uart_progress_memory=", k230_uart_progress_memory_setup);
+
