--- a/sway/input/text_input.c
+++ b/sway/input/text_input.c
@@ -362,7 +362,25 @@
 		return;
 	}
 
-	sway_text_input_create(relay, wlr_text_input);
+	struct sway_text_input *text_input =
+		sway_text_input_create(relay, wlr_text_input);
+	if (!text_input) {
+		return;
+	}
+	// A client may create its text input after its surface already holds
+	// keyboard focus (GTK4 does so on the first focused entry). Focus
+	// changes are the only other place enter is sent, so without this the
+	// client never learns its surface and its enable is ignored.
+	struct wlr_surface *focused =
+		relay->seat->wlr_seat->keyboard_state.focused_surface;
+	if (focused && wl_resource_get_client(wlr_text_input->resource)
+			== wl_resource_get_client(focused->resource)) {
+		if (relay->input_method) {
+			wlr_text_input_v3_send_enter(wlr_text_input, focused);
+		} else {
+			text_input_set_pending_focused_surface(text_input, focused);
+		}
+	}
 }
 
 static void input_popup_set_focus(struct sway_input_popup *popup,
