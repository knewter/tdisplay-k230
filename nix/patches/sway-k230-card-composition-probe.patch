+	view_k230_card_mirror_destroy(view);
@@ -1289,0 +1291,29 @@
+}
+
+struct k230_card_mirror_data { struct wlr_scene_tree *tree; double scale; };
+static void k230_card_mirror_buffer(struct wlr_scene_buffer *buffer, int sx, int sy, void *data) {
+	struct k230_card_mirror_data *mirror = data;
+	if (buffer->buffer == NULL) return;
+	struct wlr_scene_buffer *copy = wlr_scene_buffer_create(mirror->tree, buffer->buffer);
+	if (copy == NULL) return;
+	int width = buffer->dst_width ? buffer->dst_width : buffer->buffer->width;
+	int height = buffer->dst_height ? buffer->dst_height : buffer->buffer->height;
+	wlr_scene_buffer_set_source_box(copy, &buffer->src_box);
+	wlr_scene_buffer_set_dest_size(copy, width * mirror->scale, height * mirror->scale);
+	wlr_scene_buffer_set_filter_mode(copy, buffer->filter_mode);
+	wlr_scene_node_set_position(&copy->node, sx * mirror->scale, sy * mirror->scale);
+}
+void view_k230_card_mirror_destroy(struct sway_view *view) {
+	if (view->k230_card_mirror) { wlr_scene_node_destroy(&view->k230_card_mirror->node); view->k230_card_mirror = NULL; }
+	if (view->content_tree) wlr_scene_node_set_enabled(&view->content_tree->node, true);
+}
+void view_k230_card_mirror_update(struct sway_view *view) {
+	if (getenv("SWAY_K230_CARD_COMPOSITION_PROBE") == NULL || view->content_tree == NULL) return;
+	view_k230_card_mirror_destroy(view);
+	view->k230_card_mirror = wlr_scene_tree_create(root->layers.shell_overlay);
+	if (!view->k230_card_mirror) return;
+	struct k230_card_mirror_data data = { .tree = view->k230_card_mirror, .scale = 0.5 };
+	wlr_scene_node_for_each_buffer(&view->content_tree->node, k230_card_mirror_buffer, &data);
+	wlr_scene_node_set_position(&view->k230_card_mirror->node, 24, 96);
+	wlr_scene_node_set_enabled(&view->content_tree->node, false);
+	sway_log(SWAY_INFO, "K230_CARD_MIRROR view=%p scale=0.5 commit=live", view);
