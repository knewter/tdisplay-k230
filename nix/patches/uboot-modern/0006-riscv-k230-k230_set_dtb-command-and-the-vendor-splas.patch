diff --git a/board/canaan/k230_canmv/k230_gpio.c b/board/canaan/k230_canmv/k230_gpio.c
new file mode 100644
index 0000000000..01029b7e2e
--- /dev/null
+++ b/board/canaan/k230_canmv/k230_gpio.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * K230 GPIO helper used by the splash code (panel reset and backlight
+ * enable). Verbatim behaviour of Canaan's SDK U-Boot 2022.10
+ * k230_gpio() (board/canaan/common/k230_board_common.c), including its
+ * data-register write in the 'o' case, which the board's reset sequence
+ * was proven against (docs/evidence/boot-splash*).
+ */
+
+#include <asm/io.h>
+#include <linux/types.h>
+#include <stdio.h>
+#include "k230_board_common.h"
+
+#define GPIO_BASE_ADDR0		0x9140B000UL
+#define GPIO_EXT_PORTA		0x50
+
+#define K230_SET_BIT(val, bit) ((val) | (1 << (bit)))
+#define K230_CLER_BIT(val, bit) ((val) & ~(1 << (bit)))
+#define K230_GET_BIT(val, bit) (((val) >> (bit)) & 1)
+
+int k230_gpio(char opt, int pin, char *value)
+{
+	volatile u32 *gpio_dr = (volatile u32 *)(GPIO_BASE_ADDR0 + pin / 32 * 0x1000);
+	volatile u32 *gpio_ddr = gpio_dr + 1;
+	volatile u32 *gpio_value_in =
+		(volatile u32 *)(GPIO_BASE_ADDR0 + GPIO_EXT_PORTA + pin / 32 * 4);
+	u32 reg_org;
+
+	if (pin > 71)
+		return -1;
+
+	if (opt == 's') {
+		if (!value) {
+			printf("value is NULL\n");
+			return -1;
+		}
+		reg_org = *gpio_dr;
+		if (*value == 0)
+			*gpio_dr = K230_CLER_BIT(reg_org, pin % 32);
+		else
+			*gpio_dr = K230_SET_BIT(reg_org, pin % 32);
+	} else if (opt == 'g') {
+		reg_org = *gpio_value_in;
+		*value = K230_GET_BIT(reg_org, pin % 32);
+	} else if (opt == 'i') {
+		reg_org = *gpio_ddr;
+		*gpio_ddr = K230_CLER_BIT(reg_org, pin % 32);
+	} else if (opt == 'o') {
+		reg_org = *gpio_ddr;
+		*gpio_ddr = K230_SET_BIT(reg_org, pin % 32);
+		if (value && *value)
+			*gpio_dr = K230_SET_BIT(reg_org, pin % 32);
+		else if (value && *value == 0)
+			*gpio_dr = K230_CLER_BIT(reg_org, pin % 32);
+	} else {
+		printf("opt %c is invalid\n", opt);
+		return -1;
+	}
+
+	return 0;
+}
diff --git a/board/canaan/k230_canmv/k230_set_dtb.c b/board/canaan/k230_canmv/k230_set_dtb.c
new file mode 100644
index 0000000000..5635faa37a
--- /dev/null
+++ b/board/canaan/k230_canmv/k230_set_dtb.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * `k230_set_dtb`: choose the device-tree file name for the `blinux` boot.
+ *
+ * Reduced port of the vendor command (SDK U-Boot 2022.10
+ * board/canaan/common/k230_board_common.c, do_k230_set_dtb): read the file
+ * named by the first of force_dtb, lcd_dtb that exists on the boot
+ * partition (mmc ${mmc_boot_dev_num}:1) into the `dtb` environment variable
+ * and save the environment if that changed it. This image always ships
+ * force_dtb (nix/sd-image.nix), which short-circuits the vendor's display
+ * probing, so the vendor's I2C probe of the HDMI and LCD bridges and its
+ * hdmi_dtb branch are not ported; lcd_dtb is the vendor's own fallback.
+ */
+
+#include <command.h>
+#include <env.h>
+#include <string.h>
+#include <vsprintf.h>
+
+#define K230_DTB_SCRATCH	0x7f00000UL
+
+static int k230_set_dtb_from(const char *file)
+{
+	char cmd[96];
+	char *name = (char *)K230_DTB_SCRATCH;
+	const char *cur;
+
+	snprintf(cmd, sizeof(cmd), "ext4load mmc ${mmc_boot_dev_num}:1 0x%lx %s",
+		 K230_DTB_SCRATCH, file);
+	memset(name, 0, 512);
+	if (run_command(cmd, 0))
+		return -1;
+
+	name[strcspn(name, "\r\n")] = '\0';
+	cur = env_get("dtb");
+	if (cur && !strcmp(cur, name))
+		return 0;
+
+	if (env_set("dtb", name) || env_save()) {
+		printf("dtb env set error\n");
+		return 1;
+	}
+
+	return 0;
+}
+
+static int do_k230_set_dtb(struct cmd_tbl *cmdtp, int flag, int argc,
+			   char *const argv[])
+{
+	if (!k230_set_dtb_from("force_dtb"))
+		return CMD_RET_SUCCESS;
+	if (!k230_set_dtb_from("lcd_dtb"))
+		return CMD_RET_SUCCESS;
+
+	printf("k230_set_dtb: neither force_dtb nor lcd_dtb is readable\n");
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(k230_set_dtb, 1, 0, do_k230_set_dtb,
+	   "set the dtb file name from the boot partition",
+	   "reads force_dtb, else lcd_dtb, into $dtb and saves the environment on change");
