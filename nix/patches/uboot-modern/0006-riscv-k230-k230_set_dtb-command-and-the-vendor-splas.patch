index e793e9993e..078feaa281 100644
--- a/board/canaan/k230_canmv/Kconfig
+++ b/board/canaan/k230_canmv/Kconfig
@@ -12,6 +12,43 @@ config SYS_CPU
 config TEXT_BASE
 	default 0x0
 
+config CMD_K230_SET_DTB
+	bool "k230_set_dtb: choose the DTB file from the boot partition"
+	depends on CMD_EXT4 && ENV_IS_IN_MMC
+	help
+	  Vendor-compatible command used by this project's `blinux`
+	  environment variable (firmware/stage1/tdisplay.env).
+
+config K230_BARE_DISP_LOGO
+	bool "Light the RM69A10 panel and show /logo.xrgb from U-Boot"
+	select LAST_STAGE_INIT
+	select OF_BOARD_SETUP
+	help
+	  Bare-metal DSI/VO bring-up and splash from Canaan's SDK U-Boot,
+	  patched for the RM69A10 568x1232 panel. Needs the vendor sources
+	  copied in by nix/uboot-k230-modern.nix (board/canaan/k230_canmv/logo).
+
+config K230_BARE_DISP_LOGO_RM69A10
+	bool "RM69A10 568x1232 panel"
+	depends on K230_BARE_DISP_LOGO
+	default y
+
+config K230_BARE_DISP_LOGO_DF
+	bool "df screen"
+	depends on K230_BARE_DISP_LOGO
+
+config K230_BARE_DISP_LOGO_ILI9881
