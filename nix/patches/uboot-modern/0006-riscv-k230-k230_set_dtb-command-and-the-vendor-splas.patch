+	depends on K230_BARE_DISP_LOGO
+
+config K230_BARE_DISP_LOGO_FB_ADDR
+	hex "Scanout framebuffer address"
+	depends on K230_BARE_DISP_LOGO
+	default 0x10000000
+	help
+	  Must match the reserved-memory node the kernel device tree
+	  declares (nix/boot-splash.nix is the single source).
+
 config BOARD_SPECIFIC_OPTIONS
 	def_bool y
 	select CANAAN_K230
