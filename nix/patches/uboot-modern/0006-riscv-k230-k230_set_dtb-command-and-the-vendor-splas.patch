diff --git a/board/canaan/k230_canmv/board.c b/board/canaan/k230_canmv/board.c
index 7d012df214..5b2cddadb6 100644
--- a/board/canaan/k230_canmv/board.c
+++ b/board/canaan/k230_canmv/board.c
@@ -3,3 +3,52 @@
  * Copyright (c) 2025, Junhui Liu <junhui.liu@pigmoral.tech>
  */
 
+#include <event.h>
+#include <fdt_support.h>
+#include <linux/libfdt.h>
+
+#ifdef CONFIG_K230_BARE_DISP_LOGO
+int k230_display_logo_is_ready(void);
+int k230_display_logo(void);
+
+/*
+ * The vendor tree called last_stage_init() directly; in this U-Boot it is an
+ * event. Runs after the environment is loaded and storage is up, because the
+ * splash reads /logo.xrgb from the boot partition.
+ */
+static int k230_last_stage_init(void)
+{
+	k230_display_logo();
+
+	return 0;
+}
+EVENT_SPY_SIMPLE(EVT_LAST_STAGE_INIT, k230_last_stage_init);
+
+/*
+ * Tell the kernel that stage 1 lit the panel and what is on it: the
+ * `canaan,stage1-splash` property on /chosen, the contract
+ * display/panel and nix/patches/mainline/ read (openspec archive
+ * 2026-10-20-the-mainline-kernel-keeps-the-boot-splash). Cleared when a
+ * reused FDT comes from an attempt that failed.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int chosen = fdt_path_offset(blob, "/chosen");
+
+	if (!k230_display_logo_is_ready()) {
+		if (chosen >= 0)
+			fdt_delprop(blob, chosen, "canaan,stage1-splash");
+		return 0;
+	}
+
+	chosen = fdt_find_or_add_subnode(blob, 0, "chosen");
+	if (chosen < 0) {
+		printf("cannot add /chosen for stage-1 splash: %d\n", chosen);
+		return 0;
+	}
+	if (fdt_setprop_empty(blob, chosen, "canaan,stage1-splash"))
+		printf("cannot set stage-1 splash flag\n");
+
+	return 0;
+}
+#endif
