+    kd_dwc_lpdt_send_short_pkg(param8, sizeof(param8));
+    kd_dwc_lpdt_send_pkg(param9, sizeof(param9));
+    msleep(120);
+    kd_dwc_lpdt_send_pkg(param10, sizeof(param10));
