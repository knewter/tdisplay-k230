+
+void output_k230_initial_splash_update_position(struct sway_output *output) {
+	if (output->k230_initial_splash != NULL) {
+		wlr_scene_node_set_position(&output->k230_initial_splash->node,
+			output->lx, output->ly);
+	}
+}
+
+struct k230_initial_splash_ready_data {
+	struct wlr_scene_buffer *initial_splash;
+	bool initial_splash_seen;
+	bool top_layer_visible;
+	bool view_visible;
+};
+
+static bool k230_initial_splash_node_has_descriptor(struct wlr_scene_node *node,
+		enum sway_scene_descriptor_type type, void **data) {
+	for (; node != NULL; ) {
+		void *desc = scene_descriptor_try_get(node, type);
+		if (desc != NULL) {
+			*data = desc;
+			return true;
+		}
+		if (node->parent == NULL) {
+			break;
+		}
+		node = &node->parent->node;
+	}
+	return false;
+}
+
+static void k230_initial_splash_ready_iterator(
+		struct wlr_scene_buffer *buffer, int sx, int sy, void *data) {
+	(void)sx;
+	(void)sy;
+	struct k230_initial_splash_ready_data *ready = data;
+	/*
+	 * scene_buffer_get_texture() may upload the immutable logo, release its
+	 * wlr_buffer and retain only its texture. Identity must therefore win over
+	 * the live-buffer test below.
+	 */
+	if (buffer == ready->initial_splash) {
+		ready->initial_splash_seen = true;
+		return;
+	}
+	/*
+	 * Readiness only concerns Wayland view and layer-shell replacements. The
+	 * public surface API preserves attached-buffer state after wlroots uploads
+	 * and releases a scene buffer, unlike the private scene texture field.
+	 */
+	struct wlr_scene_surface *scene_surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (scene_surface == NULL || !wlr_surface_has_buffer(scene_surface->surface)) {
+		return;
+	}
+
+	/*
+	 * shell_background is below the placeholder in the global scene order.
+	 * Ignore it so a black swaybg buffer cannot retire the logo. This iterator
+	 * checks enabled output-intersecting Wayland surfaces; it does not infer
+	 * occlusion from their order.
+	 */
+	if (!ready->initial_splash_seen) {
+		return;
+	}
+
+	void *desc;
+	if (k230_initial_splash_node_has_descriptor(&buffer->node,
+			SWAY_SCENE_DESC_VIEW, &desc)) {
+		ready->view_visible = true;
+	}
+	if (k230_initial_splash_node_has_descriptor(&buffer->node,
+			SWAY_SCENE_DESC_LAYER_SHELL, &desc)) {
+		struct sway_layer_surface *layer_surface = desc;
+		if (layer_surface->mapped &&
+				layer_surface->layer_surface->current.layer ==
+				ZWLR_LAYER_SHELL_V1_LAYER_TOP) {
+			ready->top_layer_visible = true;
+		}
+	}
+}
+
+bool output_k230_initial_splash_has_replacement(struct sway_output *output) {
+	if (output->k230_initial_splash == NULL || output->scene_output == NULL) {
+		return false;
+	}
+
+	struct k230_initial_splash_ready_data ready = {
+		.initial_splash = output->k230_initial_splash,
+	};
+	wlr_scene_output_for_each_buffer(output->scene_output,
+		k230_initial_splash_ready_iterator, &ready);
+	return ready.view_visible && ready.top_layer_visible;
+}
+
+void output_k230_initial_splash_handle_present(struct sway_output *output,
+		const struct wlr_output_event_present *event) {
+	if (output->k230_initial_splash == NULL ||
+			event->commit_seq !=
+			output->k230_initial_splash_replacement_commit_seq) {
+		return;
+	}
+
+	/*
+	 * The sequence is recorded only after a state built with a non-placeholder
+	 * scene buffer commits successfully. Matching it to this compositor event
+	 * avoids treating an earlier scanout or a raw client map as readiness.
+	 */
+	sway_log(SWAY_INFO, "K230 initial splash removed output=%s commit_seq=%u",
+		output->wlr_output->name, event->commit_seq);
+	wlr_scene_node_destroy(&output->k230_initial_splash->node);
+	output->k230_initial_splash = NULL;
+	output->k230_initial_splash_replacement_commit_seq = 0;
+}
+
+static void output_k230_initial_splash_destroy(struct sway_output *output) {
+	if (output->k230_initial_splash != NULL) {
+		wlr_scene_node_destroy(&output->k230_initial_splash->node);
+		output->k230_initial_splash = NULL;
+		output->k230_initial_splash_replacement_commit_seq = 0;
+	}
+}
