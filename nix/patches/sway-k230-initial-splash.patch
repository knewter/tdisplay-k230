+#define K230_INITIAL_SPLASH_ENV "SWAY_K230_INITIAL_SPLASH"
+#define K230_INITIAL_SPLASH_OUTPUT_ENV "SWAY_K230_INITIAL_SPLASH_OUTPUT"
+#define K230_INITIAL_SPLASH_WIDTH 568
+#define K230_INITIAL_SPLASH_HEIGHT 1232
+#define K230_INITIAL_SPLASH_STRIDE (K230_INITIAL_SPLASH_WIDTH * 4)
+#define K230_INITIAL_SPLASH_SIZE \
+	((size_t)K230_INITIAL_SPLASH_STRIDE * K230_INITIAL_SPLASH_HEIGHT)
+
+struct k230_initial_splash_buffer {
+	struct wlr_buffer base;
+	uint8_t data[];
+};
+
+static void k230_initial_splash_buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct k230_initial_splash_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+	wlr_buffer_finish(wlr_buffer);
+	free(buffer);
+}
+
+static bool k230_initial_splash_buffer_begin_data_ptr_access(
+		struct wlr_buffer *wlr_buffer, uint32_t flags, void **data,
+		uint32_t *format, size_t *stride) {
+	struct k230_initial_splash_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		return false;
+	}
+
+	*data = buffer->data;
+	*format = DRM_FORMAT_XRGB8888;
+	*stride = K230_INITIAL_SPLASH_STRIDE;
+	return true;
+}
+
+static void k230_initial_splash_buffer_end_data_ptr_access(
+		struct wlr_buffer *wlr_buffer) {
+	(void)wlr_buffer;
+	// The immutable asset remains allocated until wlroots releases the buffer.
+}
+
+static const struct wlr_buffer_impl k230_initial_splash_buffer_impl = {
+	.destroy = k230_initial_splash_buffer_destroy,
+	.begin_data_ptr_access = k230_initial_splash_buffer_begin_data_ptr_access,
+	.end_data_ptr_access = k230_initial_splash_buffer_end_data_ptr_access,
+};
+
+static bool k230_initial_splash_read(int fd, uint8_t *data, size_t size) {
+	while (size > 0) {
+		ssize_t n = read(fd, data, size);
+		if (n < 0 && errno == EINTR) {
+			continue;
+		}
+		if (n <= 0) {
+			return false;
+		}
+		data += n;
+		size -= n;
+	}
+	return true;
+}
+
+static struct wlr_scene_buffer *k230_initial_splash_create(
+		struct sway_output *output) {
+	const char *path = getenv(K230_INITIAL_SPLASH_ENV);
+	const char *target = getenv(K230_INITIAL_SPLASH_OUTPUT_ENV);
+	if (path == NULL || path[0] == '\0' || target == NULL || target[0] == '\0') {
+		return NULL;
+	}
+	if (strcmp(target, output->wlr_output->name) != 0) {
+		return NULL;
+	}
+
+	struct wlr_output_mode *mode = wlr_output_preferred_mode(output->wlr_output);
+	if (mode == NULL || mode->width != K230_INITIAL_SPLASH_WIDTH ||
+			mode->height != K230_INITIAL_SPLASH_HEIGHT) {
+		sway_log(SWAY_ERROR, "%s needs a %dx%d preferred mode",
+			K230_INITIAL_SPLASH_ENV, K230_INITIAL_SPLASH_WIDTH,
+			K230_INITIAL_SPLASH_HEIGHT);
+		return NULL;
+	}
+
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		sway_log_errno(SWAY_ERROR, "Unable to open K230 initial splash asset");
+		return NULL;
+	}
+
+	struct stat st;
+	if (fstat(fd, &st) < 0) {
+		sway_log_errno(SWAY_ERROR, "Unable to stat K230 initial splash asset");
+		close(fd);
+		return NULL;
+	}
+	if (!S_ISREG(st.st_mode) || st.st_size != (off_t)K230_INITIAL_SPLASH_SIZE) {
+		sway_log(SWAY_ERROR, "K230 initial splash asset has wrong size (need %zu bytes)",
+			K230_INITIAL_SPLASH_SIZE);
+		close(fd);
+		return NULL;
+	}
+
+	struct k230_initial_splash_buffer *buffer =
+		calloc(1, sizeof(*buffer) + K230_INITIAL_SPLASH_SIZE);
+	if (buffer == NULL) {
+		sway_log(SWAY_ERROR, "Unable to allocate K230 initial splash asset");
+		close(fd);
+		return NULL;
+	}
+
+	bool read_ok = k230_initial_splash_read(fd, buffer->data,
+		K230_INITIAL_SPLASH_SIZE);
+	close(fd);
+	if (!read_ok) {
+		sway_log(SWAY_ERROR, "Unable to read complete K230 initial splash asset");
+		free(buffer);
+		return NULL;
+	}
+
+	wlr_buffer_init(&buffer->base, &k230_initial_splash_buffer_impl,
+		K230_INITIAL_SPLASH_WIDTH, K230_INITIAL_SPLASH_HEIGHT);
+	/*
+	 * This is deliberately a root layer, not output->layers.shell_bottom:
+	 * output_create puts the latter under disabled root->staging until the
+	 * first transaction. The target output is selected by exact name and this
+	 * node is positioned when that transaction establishes layout coordinates.
+	 * It stays above layer-shell backgrounds and below normal toplevels/top bar.
+	 */
+	struct wlr_scene_buffer *scene_buffer = wlr_scene_buffer_create(
+		root->layers.shell_bottom, &buffer->base);
+	if (scene_buffer == NULL) {
+		sway_log(SWAY_ERROR, "Unable to add K230 initial splash to scene");
+		wlr_buffer_drop(&buffer->base);
+		return NULL;
+	}
+	wlr_buffer_drop(&buffer->base);
+	sway_log(SWAY_INFO, "K230 initial splash seeded output=%s asset=%s",
+		output->wlr_output->name, path);
+	return scene_buffer;
+}
