 static int lt9611_mipi_input_digital(struct lt9611 *lt9611,
 				     const struct drm_display_mode *mode)
 {
+	int ret;
+
 	struct reg_sequence reg_cfg[] = {
 		{ 0x8300, LT9611_4LANES },
 		{ 0x830a, 0x00 },
 		{ 0x824f, 0x80 },
 		{ 0x8250, 0x10 },
+		{ 0x8303, 0x00 },
 		{ 0x8302, 0x0a },
 		{ 0x8306, 0x0a },
 	};
 
-	if (lt9611->dsi1_node)
-		reg_cfg[1].def = 0x03;
+	if (lt9611->dsi1_node) {
+		if (lt9611->dsi0_node) {
+			/* Dual port (Port A + B) */
+			reg_cfg[1].def = 0x03;
+		} else {
+			/*
+			 * Single port B:
+			 * - 0x8303 bit 6: port swap (1=PortB as primary)
+			 * - 0x8250 bit 3:2: byte_clk source (01=PortB)
+			 */
+			reg_cfg[3].def = 0x14;
+			reg_cfg[4].def = 0x40;
+		}
+	}
+
+	ret = regmap_multi_reg_write(lt9611->regmap, reg_cfg, ARRAY_SIZE(reg_cfg));
+	if (ret || lt9611->dsi0_node || !lt9611->dsi1_node)
+		return ret;
 
-	return regmap_multi_reg_write(lt9611->regmap, reg_cfg, ARRAY_SIZE(reg_cfg));
+	/*
+	 * K230 boards (Canaan CanMV reference design, LILYGO T-Display-K230)
+	 * route DSI into Port B with lanes reordered and two pairs P/N
+	 * swapped ("LT9611 swap" on the T-Display schematic). Canaan's own
+	 * RT-Smart LT9611 connector driver (k230_sdk
+	 * src/big/mpp/kernel/connector/src/lt9611.c, LT9611_PORTB) writes
+	 * these for that wiring; without them the video check reads zero.
+	 * Verified live on T-Display-K230: hactive=1024 vactive=768 decoded.
+	 */
+	return regmap_multi_reg_write(lt9611->regmap, k230_port_b_cfg,
+				      ARRAY_SIZE(k230_port_b_cfg));
 }
 
