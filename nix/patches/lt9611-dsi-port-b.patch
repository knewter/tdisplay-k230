+/*
+ * Output side for K230 single-Port-B boards, mirroring Canaan's RT-Smart
+ * LT9611 connector driver (k230_sdk src/big/mpp/kernel/connector/src/
+ * lt9611.c: setup_pll, setup_pcr, setup_timing, hdmi_tx_digital,
+ * hdmi_tx_phy, enable_hdmi_out). The generic sequence leaves a
+ * T-Display-K230's monitor black even with the input decoded; applying
+ * this afterwards (by hand, 2026-09-29, CEA 1080p60) put the shell on
+ * the monitor.
+ */
+static void lt9611_k230_output_setup(struct lt9611 *lt9611,
+				     const struct drm_display_mode *mode)
+{
+	unsigned int pclk = mode->clock, postdiv, pcr_m, half;
+	unsigned int hfp = mode->hsync_start - mode->hdisplay;
+	unsigned int hs = mode->hsync_end - mode->hsync_start;
+	unsigned int hbp = mode->htotal - mode->hsync_end;
+	unsigned int vfp = mode->vsync_start - mode->vdisplay;
+	unsigned int vs = mode->vsync_end - mode->vsync_start;
+	unsigned int vbp = mode->vtotal - mode->vsync_end;
+	struct regmap *r = lt9611->regmap;
+	static const struct reg_sequence pll[] = {
+		{ 0x8123, 0x40 }, { 0x8124, 0x62 }, { 0x8125, 0x80 },
+		{ 0x8126, 0x55 }, { 0x812c, 0x37 }, { 0x812f, 0x01 },
+		{ 0x8127, 0x66 }, { 0x8128, 0x88 }, { 0x812a, 0x20 },
+	};
+	static const struct reg_sequence pcr[] = {
+		{ 0x830b, 0x01 }, { 0x830c, 0x10 }, { 0x8348, 0x00 },
+		{ 0x8349, 0x81 }, { 0x8321, 0x4a }, { 0x8324, 0x71 },
+		{ 0x8325, 0x30 }, { 0x832a, 0x01 }, { 0x834a, 0x40 },
+		{ 0x832d, 0x40 }, { 0x8331, 0x08 }, { 0x831d, 0x10 },
+	};
+	static const struct reg_sequence tx[] = {
+		{ 0x8443, 0x21 }, { 0x8445, 0x40 }, { 0x8447, 0x34 },
+		{ 0x843d, 0x0a }, { 0x82d6, 0x8e }, { 0x82d7, 0x04 },
+		{ 0x8130, 0x6a }, { 0x8131, 0x44 }, { 0x8132, 0x4a },
+		{ 0x8133, 0x0b }, { 0x8134, 0x00 }, { 0x8135, 0x00 },
+		{ 0x8136, 0x00 }, { 0x8137, 0x44 }, { 0x813f, 0x0f },
+		{ 0x8140, 0x98 }, { 0x8141, 0x98 }, { 0x8142, 0x98 },
+		{ 0x8143, 0x98 }, { 0x8144, 0x0a },
+	};
+	static const struct reg_sequence out[] = {
+		{ 0x8123, 0x40 }, { 0x82de, 0x20 }, { 0x82de, 0xe0 },
+		{ 0x8018, 0xdc }, { 0x8018, 0xfc }, { 0x8016, 0xf1 },
+		{ 0x8016, 0xf3 }, { 0x8011, 0x5a }, { 0x8011, 0xfa },
+	};
+
+	/* PLL */
+	regmap_multi_reg_write(r, pll, ARRAY_SIZE(pll));
+	if (pclk > 150000) {
+		regmap_write(r, 0x812d, 0x88);
+		postdiv = 1;
+	} else if (pclk > 80000) {
+		regmap_write(r, 0x812d, 0x99);
+		postdiv = 2;
+	} else {
+		regmap_write(r, 0x812d, 0xaa);
+		postdiv = 4;
+	}
+	pcr_m = (pclk * 5 * postdiv) / 27000 - 1;
+	regmap_write(r, 0x832d, 0x40);
+	regmap_write(r, 0x8331, 0x08);
+	regmap_write(r, 0x8326, 0x80 | pcr_m);
+	half = pclk / 2;
+	regmap_write(r, 0x82e3, half / 65536);
+	half %= 65536;
+	regmap_write(r, 0x82e4, half / 256);
+	regmap_write(r, 0x82e5, half % 256);
+	regmap_write(r, 0x82de, 0x20);
+	regmap_write(r, 0x82de, 0xe0);
+	regmap_write(r, 0x8011, 0x5a);
+	regmap_write(r, 0x8011, 0xfa);
+	regmap_write(r, 0x8016, 0xf2);
+	regmap_write(r, 0x8018, 0xdc);
+	regmap_write(r, 0x8018, 0xfc);
+	regmap_write(r, 0x8016, 0xf3);
+
+	/* PCR */
+	regmap_multi_reg_write(r, pcr, ARRAY_SIZE(pcr));
+	regmap_write(r, 0x8326, pcr_m);
+	regmap_write(r, 0x8011, 0x5a);
+	regmap_write(r, 0x8011, 0xfa);
+
+	/* Timing */
+	regmap_write(r, 0x830d, mode->vtotal / 256);
+	regmap_write(r, 0x830e, mode->vtotal % 256);
+	regmap_write(r, 0x830f, mode->vdisplay / 256);
+	regmap_write(r, 0x8310, mode->vdisplay % 256);
+	regmap_write(r, 0x8311, mode->htotal / 256);
+	regmap_write(r, 0x8312, mode->htotal % 256);
+	regmap_write(r, 0x8313, mode->hdisplay / 256);
+	regmap_write(r, 0x8314, mode->hdisplay % 256);
+	regmap_write(r, 0x8315, vs % 256);
+	regmap_write(r, 0x8316, hs % 256);
+	regmap_write(r, 0x8317, vfp % 256);
+	regmap_write(r, 0x8318, (vs + vbp) % 256);
+	regmap_write(r, 0x8319, hfp % 256);
+	regmap_write(r, 0x831a, ((hfp / 256) << 4) + (hs + hbp) / 256);
+	regmap_write(r, 0x831b, (hs + hbp) % 256);
+
+	/* TX digital + PHY, then enable */
+	regmap_multi_reg_write(r, tx, ARRAY_SIZE(tx));
+	regmap_multi_reg_write(r, out, ARRAY_SIZE(out));
+}
