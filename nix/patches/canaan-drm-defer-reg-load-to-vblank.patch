diff -ruN a/drivers/gpu/drm/canaan/canaan_vo.c b/drivers/gpu/drm/canaan/canaan_vo.c
--- a/drivers/gpu/drm/canaan/canaan_vo.c	2026-09-25 16:06:11.239082820 -0500
+++ b/drivers/gpu/drm/canaan/canaan_vo.c	2026-09-25 16:06:35.997538606 -0500
@@ -489,6 +489,24 @@
 
 	canaan_vo_write(vo, VO_DISP_IRQ_STATUS, 0xffffffff);
 
+	/* Apply any plane/CRTC shadow-register writes staged since the last
+	 * vblank (canaan_vo_arm_flush, called from canaan_crtc_atomic_flush)
+	 * right here, at the hardware's own vblank interrupt, instead of
+	 * wherever in the current scanout the atomic commit happened to run.
+	 * Board evidence: real bottom-edge gestures showed a flickering
+	 * band on the physical panel specifically on frames whose render
+	 * time ran long, while wlroots' own present-timestamp feedback
+	 * stayed cleanly vblank-aligned throughout -- consistent with the
+	 * previous synchronous, arbitrarily-timed VO_REG_LOAD_CTL write
+	 * landing mid-scan. Ordered before drm_crtc_handle_vblank so the
+	 * completion event that unblocks (drm_crtc_arm_vblank_event,
+	 * canaan_crtc_atomic_flush) corresponds to a frame whose registers
+	 * were actually just applied, not one still pending. See
+	 * docs/evidence/card-shell/bottom-band-flicker/
+	 * kernel-vblank-latch.md. */
+	if (atomic_xchg(&vo->flush_pending, 0))
+		canaan_vo_flush_config(vo);
+
 	// printk("canaan_vo_irq_handler---------------\n");
 	if (atomic_read(&vo->vsync_enabled))
 		drm_crtc_handle_vblank(&canaan_crtc->base);
@@ -680,6 +698,18 @@
 	writel(0x11, vo->reg_base + VO_REG_LOAD_CTL);
 }
 
+/* Stage a shadow-register commit (VO_REG_LOAD_CTL) for the vblank IRQ
+ * handler to actually apply, instead of canaan_crtc_atomic_flush writing
+ * it directly at arbitrary atomic-commit time. canaan_crtc_atomic_flush
+ * already requests a vblank (drm_crtc_vblank_get, for the completion
+ * event every real commit carries) in the same call, so the next
+ * hardware vblank interrupt -- which is already enabled by the time this
+ * runs -- is guaranteed to consume this within one frame period. */
+void canaan_vo_arm_flush(struct canaan_vo *vo)
+{
+	atomic_set(&vo->flush_pending, 1);
+}
