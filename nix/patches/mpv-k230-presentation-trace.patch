+
+/* Opt-in diagnostic: one feedback object per actual video-buffer commit.
+ * This records compositor presentation, not photons or decoder completion.
+ * No tracing or extra protocol objects are created in normal playback. */
+struct k230_feedback {
+    struct vo *vo;
+    uint64_t serial, frame_id, submitted_ns;
+    double pts;
+};
+
+static uint64_t k230_monotonic_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+static void k230_sync_output(void *data, struct wp_presentation_feedback *feedback,
+                             struct wl_output *output)
+{
+}
+
+static void k230_presented(void *data, struct wp_presentation_feedback *feedback,
+                           uint32_t hi, uint32_t lo, uint32_t ns, uint32_t refresh,
+                           uint32_t seq_hi, uint32_t seq_lo, uint32_t flags)
+{
+    struct k230_feedback *f = data;
+    uint64_t presented_ns = (((uint64_t)hi << 32) | lo) * 1000000000 + ns;
+    uint64_t sequence = ((uint64_t)seq_hi << 32) | seq_lo;
+    MP_INFO(f->vo, "K230_PRESENT serial=%" PRIu64 " frame=%" PRIu64
+        " pts=%.9f submit_mono_ns=%" PRIu64 " presented_ns=%" PRIu64
+        " receive_mono_ns=%" PRIu64 " refresh_ns=%u sequence=%" PRIu64
+        " flags=%u\n", f->serial, f->frame_id, f->pts, f->submitted_ns,
+        presented_ns, k230_monotonic_ns(), refresh, sequence, flags);
+    wp_presentation_feedback_destroy(feedback);
+    talloc_free(f);
+}
+
+static void k230_discarded(void *data, struct wp_presentation_feedback *feedback)
+{
+    struct k230_feedback *f = data;
+    MP_INFO(f->vo, "K230_DISCARD serial=%" PRIu64 " frame=%" PRIu64
+        " pts=%.9f receive_mono_ns=%" PRIu64 "\n", f->serial, f->frame_id,
+        f->pts, k230_monotonic_ns());
+    wp_presentation_feedback_destroy(feedback);
+    talloc_free(f);
+}
+
+static const struct wp_presentation_feedback_listener k230_listener = {
+    k230_sync_output, k230_presented, k230_discarded,
 };
 
