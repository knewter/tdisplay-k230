+static int device = -1;
+static bool adopted, child_blocked, unsafe_mapping;
+static pthread_mutex_t device_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t fork_once = PTHREAD_ONCE_INIT;
+static int fork_status = -1;
 static uint32_t length = 0;
 static void * mapped = NULL;
 
-vg_lite_error_t vg_lite_kernel(vg_lite_kernel_command_t command, void * data)
+/* Children must not inherit an ioctl capability even before exec.
+ * MADV_DONTFORK below excludes the GPU mapping from their address space. */
+static void revoke_in_child(void)
+{
+    if (device >= 0) close(device);
+    device = -1;
+    mapped = NULL;
+    child_blocked = true;
+    /* A failed allocation ioctl may have left an unknown driver mapping.
+     * Do not execute any app child until this process has been restarted. */
+    if (unsafe_mapping) _exit(127);
+    pthread_mutex_unlock(&device_lock);
+}
+
+static void before_fork(void) { pthread_mutex_lock(&device_lock); }
+static void after_fork(void) { pthread_mutex_unlock(&device_lock); }
+static void register_fork_handler(void)
+{
+    fork_status = pthread_atfork(before_fork, after_fork, revoke_in_child);
+}
+static bool install_fork_handler(void)
+{
+    return pthread_once(&fork_once, register_fork_handler) == 0 && fork_status == 0;
+}
+
+vg_lite_error_t k230_vg_lite_adopt_device_fd(int fd)
+{
+    struct stat info;
+    vg_lite_error_t result = VG_LITE_INVALID_ARGUMENT;
+    if (!install_fork_handler()) return VG_LITE_GENERIC_IO;
+    pthread_mutex_lock(&device_lock);
+    int flags = fcntl(fd, F_GETFL);
+    if (child_blocked || device >= 0 || mapped != NULL || flags < 0 ||
+        (flags & O_ACCMODE) != O_RDWR || fstat(fd, &info) != 0 ||
+        !S_ISCHR(info.st_mode)) goto out;
+    int duplicate = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+    if (duplicate < 0) { result = VG_LITE_GENERIC_IO; goto out; }
+    device = duplicate;
+    adopted = true;
+    result = VG_LITE_SUCCESS;
+out:
+    pthread_mutex_unlock(&device_lock);
+    return result;
+}
+
+static bool protect_mapping(void *memory, size_t bytes)
+{
+    if (!bytes) return true;
+    if (!memory) return false;
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0) return false;
+    uintptr_t address = (uintptr_t)memory;
+    size_t offset = address % (size_t)page;
+    if (bytes > SIZE_MAX - offset) return false;
+    return madvise((void *)(address - offset), bytes + offset, MADV_DONTFORK) == 0;
+}
+
+static bool protect_result(vg_lite_kernel_command_t command, void *data)
+{
+    if (command == VG_LITE_INITIALIZE) {
+        vg_lite_kernel_initialize_t *init = data;
+        for (unsigned i = 0; i < CMDBUF_COUNT; i++)
+            if (!protect_mapping(init->command_buffer[i], init->command_buffer_size)) return false;
+        if (!protect_mapping(init->logical_addr, (size_t)init->tessbuf_size + init->countbuf_size)) return false;
+        if (init->context && init->context->power_context_logical &&
+            !protect_mapping(init->context->power_context_logical, init->context->power_context_size)) return false;
+    } else if (command == VG_LITE_ALLOCATE) {
+        vg_lite_kernel_allocate_t *allocation = data;
+        return protect_mapping(allocation->memory, allocation->bytes);
+    } else if (command == VG_LITE_MAP_MEMORY) {
+        vg_lite_kernel_map_memory_t *mapping = data;
+        return protect_mapping(mapping->logical, mapping->bytes);
+    }
+    return true;
+}
