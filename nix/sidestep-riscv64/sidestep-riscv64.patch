+/// RISC-V's hard-float calling convention (LP64D): the leaves of `ty`
+/// when it passes in floating-point registers, as a `float`, `double` or
+/// struct of one or two scalars at least one of which is a `float` or
+/// `double` and the other a floating-point value or an integer of at most
+/// 8 bytes, with arrays and nested structs flattened. `(offset, is float,
+/// size)` for each.
+#[cfg(target_arch = "riscv64")]
+fn float_leaves(ty: &Ty) -> Option<Vec<(usize, bool, u8)>> {
+    if ty.size() > 16 {
+        return None;
+    }
+    let mut leaves = Vec::new();
+    ty.leaves(0, &mut leaves, 2)?;
+    let flat: Vec<(usize, bool, u8)> = leaves
+        .into_iter()
+        .map(|(at, leaf)| match leaf {
+            Leaf::Float(n) => (at, true, n),
+            Leaf::Int(n) => (at, false, n),
+        })
+        .collect();
+    let ok = !flat.is_empty()
+        && flat.iter().any(|&(_, f, n)| f && n <= 8)
+        && flat.iter().all(|&(_, _, n)| n <= 8);
+    ok.then_some(flat)
+}
+
+/// How a scalar integer extends on RISC-V: to 32 bits by its own
+/// signedness, then sign-extended to 64, so an `unsigned int` is
+/// sign-extended too.
+#[cfg(target_arch = "riscv64")]
+fn riscv_ext(ty: &Ty) -> Ext {
+    match *ty {
+        Ty::Int { size: 4, .. } => Ext::Sign,
+        Ty::Int { size, signed } if size < 4 => {
+            if signed {
+                Ext::Sign
+            } else {
+                Ext::Zero
+            }
+        }
+        _ => Ext::None,
+    }
+}
