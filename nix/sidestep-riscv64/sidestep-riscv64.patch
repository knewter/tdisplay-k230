+/// riscv64 (LP64D). The frame: ra at sp+0, then a0-a7 at sp+16 and
+/// fa0-fa7 at sp+80, 16-byte slots whose upper halves are unused (so the
+/// block reads as `call::Registers`). The jump goes through t1, which no
+/// argument uses. A nil receiver's `objc_msgSend` branches to label 1
+/// before the frame.
+#[cfg(target_arch = "riscv64")]
+macro_rules! saving_entry {
+    (
+        name: $name:literal,
+        directives: [$($directive:literal),* $(,)?],
+        before: [$($before:expr),* $(,)?],
+        setup: [$($setup:literal),* $(,)?],
+        call: $callee:path,
+        after: [$($after:literal),* $(,)?]
+        $(, consts: [$($cname:ident = $cvalue:expr),* $(,)?])? $(,)?
+    ) => {
+        std::arch::global_asm!(
+            // A module's assembly is assembled for the default features,
+            // so ask for the double-precision registers it saves.
+            ".option push",
+            ".option arch, +d",
+            ".text",
+            ".p2align 2",
+            concat!(".globl ", $name),
+            $($directive,)*
+            concat!(".type ", $name, ", @function"),
+            concat!($name, ":"),
+            ".cfi_startproc",
+            $($before,)*
+            "addi sp, sp, -208",
+            ".cfi_def_cfa_offset 208",
+            "sd ra, 0(sp)",
+            ".cfi_offset ra, -208",
+            "sd a0, 16(sp)",
+            "sd a1, 24(sp)",
+            "sd a2, 32(sp)",
+            "sd a3, 40(sp)",
+            "sd a4, 48(sp)",
+            "sd a5, 56(sp)",
+            "sd a6, 64(sp)",
+            "sd a7, 72(sp)",
+            "fsd fa0, 80(sp)",
+            "fsd fa1, 96(sp)",
+            "fsd fa2, 112(sp)",
+            "fsd fa3, 128(sp)",
+            "fsd fa4, 144(sp)",
+            "fsd fa5, 160(sp)",
+            "fsd fa6, 176(sp)",
+            "fsd fa7, 192(sp)",
+            $($setup,)*
+            "call {callee}",
+            "mv t1, a0",
+            "fld fa0, 80(sp)",
+            "fld fa1, 96(sp)",
+            "fld fa2, 112(sp)",
+            "fld fa3, 128(sp)",
+            "fld fa4, 144(sp)",
+            "fld fa5, 160(sp)",
+            "fld fa6, 176(sp)",
+            "fld fa7, 192(sp)",
+            "ld a0, 16(sp)",
+            "ld a1, 24(sp)",
+            "ld a2, 32(sp)",
+            "ld a3, 40(sp)",
+            "ld a4, 48(sp)",
+            "ld a5, 56(sp)",
+            "ld a6, 64(sp)",
+            "ld a7, 72(sp)",
+            "ld ra, 0(sp)",
+            "addi sp, sp, 208",
+            ".cfi_def_cfa_offset 0",
+            ".cfi_restore ra",
+            "jr t1",
+            $($after,)*
+            ".cfi_endproc",
+            concat!(".size ", $name, ", . - ", $name),
+            ".option pop",
