// SPDX-License-Identifier: GPL-2.0 OR MIT
// Display and touch controllers shared by the mainline panel DTB
// (k230-tdisplay-mainline-drm.dts) and the mainline HDMI DTB
// (k230-tdisplay-mainline-drm-hdmi.dts). Include after k230-tdisplay-mainline.dts.

// Mainline's k230.dtsi currently has no display or I2C controller nodes.
// Register ranges, VO/DSI IRQ, and I2C3 range/IRQ follow the pinned vendor
// k230.dtsi (7d4e1f444f461dbe3833bd99a4640e7b6c2cd529). The K230 mainline
// clock driver exposes the named display and LS-I2C clocks in the included
// binding header. The imported Canaan VO/DSI code does not call clk_get() or
// reset_control_get(); it programs its display/PHY registers directly, so
// this DTS does not attach unused, guessed clock/reset phandles to those
// nodes. I2C3 uses the mainline I2C3 functional and APB clocks; its reset ID
// is available but the generic DesignWare I2C driver does not consume it.
// Board-level clocking, reset timing, pinmux, and display power behavior
// still require physical probe evidence.

/ {
	// Stage 1 scans this XRGB buffer until Linux owns the panel. The values
	// come from nix/boot-splash.nix through nix/device-tree-mainline-drm.nix's
	// preprocessor definitions, shared with U-Boot's Kconfig fragment and with
	// the vendor tree (nix/dts/k230-tdisplay.dts). Without this node the
	// kernel may allocate over the buffer. openspec/changes/
	// the-mainline-kernel-keeps-the-boot-splash task 1.1.
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		splash_framebuffer: framebuffer@K230_SPLASH_FRAMEBUFFER_UNIT_ADDRESS {
			reg = <0x0 K230_SPLASH_FRAMEBUFFER_ADDRESS
			       0x0 K230_SPLASH_FRAMEBUFFER_SIZE>;
			no-map;
		};
	};
};

/ {
	soc {
		// Vendor genpd controller; available only with the DRM kernel port.
		sysctl_power: power-controller@91103000 {
			compatible = "canaan, k230-sysctl-power";
			reg = <0x0 0x91103000 0x0 0x1000>;
			#power-domain-cells = <1>;
		};
		// Panel touch: vendor k230.dtsi's i2c3 controller node translated
		// to the real mainline K230 clock provider IDs. Upstream's DW I2C
		// platform driver accepts an unnamed functional clock and an
		// optional "pclk" interface clock.
		i2c3: i2c@91408000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x91408000 0x0 0x1000>;
			interrupts = <24 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sysclk K230_LS_I2C3_RATE>,
				 <&sysclk K230_LS_I2C3_APB_GATE>;
			clock-names = "ref", "pclk";
			clock-frequency = <400000>;
			status = "okay";

			touch: touchscreen@5d {
				compatible = "goodix,gt9895", "goodix,gt9916";
				reg = <0x5d>;
				reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_LOW>;
				interrupt-parent = <&gpio0_ports>;
				interrupts = <23 IRQ_TYPE_LEVEL_LOW>;
				/* The controller reports X 0..1079: a finger at the
				 * long edge hit raw 1079 on the second board
				 * (docs/evidence/panel-landscape/touch-range.md), and
				 * LILYGO's own tree gives panel-max-x 1060. 1024 lost
				 * the last 5% of the glass past the panel edge. */
				touchscreen-size-x = <1080>;
				touchscreen-size-y = <2400>;
			};
		};

		vo: vo@90840000 {
			compatible = "canaan,k230-vo";
			reg = <0x0 0x90840000 0x0 0x10000>;
			interrupts = <133 IRQ_TYPE_LEVEL_HIGH>;
			// Mainline gate ops let unused-clock cleanup turn these off;
			// the VO and DSI drivers must own them. Same 0x74 gates as
			// the vendor disp_hclk/disp_aclk/dpipclk tree.
			clocks = <&sysclk K230_DISPLAY_AHB_GATE>,
				 <&sysclk K230_DISPLAY_AXI_GATE>,
				 <&sysclk K230_DISPLAY_DPIP_GATE>;
			clock-names = "ahb", "axi", "pixel";
			status = "okay";
			background = <0xffffff>;
			vth_line = <10>;

			vo_out: port {
				#address-cells = <1>;
				#size-cells = <0>;
				vop_out_dsi: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dsi_in_vop>;
				};
			};
		};

		dsi: dsi@90850000 {
			compatible = "canaan,k230-mipi-dsi";
			reg = <0x0 0x90850000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sysclk K230_DISPLAY_AHB_GATE>,
				 <&sysclk K230_DISPLAY_CFG_GATE>,
				 <&sysclk K230_DISPLAY_REF_GATE>;
			clock-names = "ahb", "cfg", "ref";
			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					dsi_in_vop: endpoint {
						remote-endpoint = <&vop_out_dsi>;
					};
				};
			};
		};
	};
};

// This logical DRM subsystem is not a child of the simple-bus SoC node: it
// has no MMIO range of its own. The VO endpoint is described below it.
/ {
	display: display-subsystem {
		compatible = "canaan,display-subsystem";
		power-domains = <&sysctl_power K230_PM_DOMAIN_DISP>;
		ports = <&vo_out>;
		status = "okay";
	};
};

#include <dt-bindings/input/input.h>

// Keyboard base I2C (openspec/changes/
// the-keyboard-base-types-lights-and-reports-its-battery). LILYGO's
// HARDWARE_PINMAP.md puts the base's charger, gauge, keypad and expander on
// IO46/IO47; machine_fpioa.c gives function 3 = IIC4_SCL/IIC4_SDA there.
// Stage 1 (vendor k230_canmv_v3p0.dts) leaves both pads as GPIO, so Linux
// muxes them here. The controller range, IRQ 25 and 400 kHz default follow
// the vendor DTB's i2c@91409000; the base runs at the 100 kHz LILYGO
// documents. Pad settings match LILYGO sensor_aht20_iomux_value(3) (0x19d1).
&pinctrl {
	// The keypad's interrupt (IO42, active low, open drain on the base) and
	// reset (IO43, active low). Stage 1 already leaves both as GPIO; naming
	// them here keeps that true whatever stage 1 does.
	tca8418_pins: tca8418-pins {
		tca8418-irq-cfg {
			pinmux = <K230_PINMUX(42, 0)>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			bias-pull-up;
		};

		tca8418-reset-cfg {
			pinmux = <K230_PINMUX(43, 0)>;
			drive-strength = <4>;
			power-source = <K230_MSC_3V3>;
			output-enable;
			input-enable;
			bias-disable;
		};
	};

	// Key backlight (task 4.2): IO52 as PWM4 (function 2, IOMUX 0x1191 in
	// LILYGO's RT-Smart code), the second PWM block's channel 1.
	kbd_backlight_pins: kbd-backlight-pins {
		kbd-backlight-cfg {
			pinmux = <K230_PINMUX(52, 2)>;
			drive-strength = <4>;
			power-source = <K230_MSC_3V3>;
			output-enable;
			bias-disable;
		};
	};

	i2c4_pins: i2c4-pins {
		// Stage 1 also muxes IO7/IO8 to IIC4 (function 2). Release them so
		// only one pad pair drives the controller. UNVERIFIED: whether the
		// duplicate mux matters; the NACKs first seen here were recorded
		// with the base's protective film still over the pogo pins.
		i2c4-io7-io8-release-cfg {
			pinmux = <K230_PINMUX(7, 0)>, <K230_PINMUX(8, 0)>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			bias-pull-down;
		};

		i2c4-scl-cfg {
			pinmux = <K230_PINMUX(46, 3)>;
			slew-rate = <0>;
			drive-strength = <8>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			output-enable;
			bias-pull-up;
			input-schmitt-enable;
		};

		i2c4-sda-cfg {
			pinmux = <K230_PINMUX(47, 3)>;
			slew-rate = <0>;
			drive-strength = <8>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			output-enable;
			bias-pull-up;
			input-schmitt-enable;
		};
	};
};

/ {
	soc {
		// PWM3-5 (vendor k230.dtsi pwm1@9140a040). Both blocks share the LS
		// PWM APB gate and reset; pwm0 is not used on this board.
		pwm1: pwm@9140a040 {
			compatible = "canaan,k230-pwm";
			reg = <0x0 0x9140a040 0x0 0x40>;
			clocks = <&sysclk K230_LS_PWM_APB_GATE>;
			resets = <&rst RST_PWM_APB>;
			#pwm-cells = <3>;
			status = "okay";
		};

		i2c4: i2c@91409000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x91409000 0x0 0x1000>;
			interrupts = <25 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sysclk K230_LS_I2C4_RATE>,
				 <&sysclk K230_LS_I2C4_APB_GATE>;
			clock-names = "ref", "pclk";
			// Stage 1 releases only i2c3 from reset; the DesignWare driver
			// deasserts a named reset at probe.
			resets = <&rst RST_I2C4>;
			clock-frequency = <100000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c4_pins>;
			status = "okay";

			// Keyboard base keypad (task 3.1). Vendor codes and legends
			// come from LILYGO tca8418_key_name(); FN and FN-R are Level3
			// (RIGHTALT) for the k230-base xkb layout, LILYGO is Super.
			keypad@34 {
				compatible = "ti,tca8418";
				reg = <0x34>;
				pinctrl-names = "default";
				pinctrl-0 = <&tca8418_pins>;
				interrupts-extended = <&gpio1_ports 10 IRQ_TYPE_LEVEL_LOW>;
				keypad,num-rows = <7>;
				keypad,num-columns = <10>;
				keypad,autorepeat;
			// BEGIN generated by tools/keyboard-base-keymap.py
			linux,keymap =
				<MATRIX_KEY(0, 0, KEY_RIGHT)>,	/*  1 RIGHT */
				<MATRIX_KEY(0, 1, KEY_LEFT)>,	/*  2 LEFT */
				<MATRIX_KEY(0, 2, KEY_RIGHTALT)>,	/*  3 FN-R */
				<MATRIX_KEY(0, 4, KEY_SPACE)>,	/*  5 SPACE */
				<MATRIX_KEY(0, 5, KEY_TAB)>,	/*  6 TAB */
				<MATRIX_KEY(0, 6, KEY_LEFTSHIFT)>,	/*  7 SHIFT */
				<MATRIX_KEY(0, 7, KEY_LEFTMETA)>,	/*  8 LILYGO */
				<MATRIX_KEY(0, 8, KEY_RIGHTALT)>,	/*  9 FN */
				<MATRIX_KEY(0, 9, KEY_CAPSLOCK)>,	/* 10 CAPS */
				<MATRIX_KEY(1, 0, KEY_MICMUTE)>,	/* 11 MIC */
				<MATRIX_KEY(1, 1, KEY_DOWN)>,	/* 12 DOWN */
				<MATRIX_KEY(1, 2, KEY_M)>,	/* 13 M */
				<MATRIX_KEY(1, 3, KEY_SPACE)>,	/* 14 SPACE */
				<MATRIX_KEY(1, 4, KEY_V)>,	/* 15 V */
				<MATRIX_KEY(1, 5, KEY_C)>,	/* 16 C */
				<MATRIX_KEY(1, 6, KEY_X)>,	/* 17 X */
				<MATRIX_KEY(1, 7, KEY_Z)>,	/* 18 Z */
				<MATRIX_KEY(1, 8, KEY_LEFTALT)>,	/* 19 ALT */
				<MATRIX_KEY(1, 9, KEY_Q)>,	/* 20 Q */
				<MATRIX_KEY(2, 0, KEY_ENTER)>,	/* 21 ENTER */
				<MATRIX_KEY(2, 1, KEY_UP)>,	/* 22 UP */
				<MATRIX_KEY(2, 2, KEY_LEFTCTRL)>,	/* 23 CTRL */
				<MATRIX_KEY(2, 3, KEY_N)>,	/* 24 N */
				<MATRIX_KEY(2, 4, KEY_B)>,	/* 25 B */
				<MATRIX_KEY(2, 5, KEY_F)>,	/* 26 F */
				<MATRIX_KEY(2, 6, KEY_D)>,	/* 27 D */
				<MATRIX_KEY(2, 7, KEY_S)>,	/* 28 S */
				<MATRIX_KEY(2, 8, KEY_A)>,	/* 29 A */
				<MATRIX_KEY(3, 1, KEY_L)>,	/* 32 L */
				<MATRIX_KEY(3, 2, KEY_K)>,	/* 33 K */
				<MATRIX_KEY(3, 3, KEY_J)>,	/* 34 J */
				<MATRIX_KEY(3, 4, KEY_H)>,	/* 35 H */
				<MATRIX_KEY(3, 5, KEY_G)>,	/* 36 G */
				<MATRIX_KEY(3, 6, KEY_R)>,	/* 37 R */
				<MATRIX_KEY(3, 7, KEY_E)>,	/* 38 E */
				<MATRIX_KEY(3, 8, KEY_W)>,	/* 39 W */
				<MATRIX_KEY(3, 9, KEY_ESC)>,	/* 40 ESC */
				<MATRIX_KEY(4, 0, KEY_BACKSPACE)>,	/* 41 DEL */
				<MATRIX_KEY(4, 1, KEY_P)>,	/* 42 P */
				<MATRIX_KEY(4, 2, KEY_O)>,	/* 43 O */
				<MATRIX_KEY(4, 3, KEY_I)>,	/* 44 I */
				<MATRIX_KEY(4, 4, KEY_U)>,	/* 45 U */
				<MATRIX_KEY(4, 5, KEY_Y)>,	/* 46 Y */
				<MATRIX_KEY(4, 6, KEY_T)>,	/* 47 T */
				<MATRIX_KEY(4, 7, KEY_2)>,	/* 48 2 */
				<MATRIX_KEY(4, 8, KEY_1)>,	/* 49 1 */
				<MATRIX_KEY(4, 9, KEY_F1)>,	/* 50 F1 */
				<MATRIX_KEY(5, 0, KEY_0)>,	/* 51 0 */
				<MATRIX_KEY(5, 1, KEY_9)>,	/* 52 9 */
				<MATRIX_KEY(5, 2, KEY_8)>,	/* 53 8 */
				<MATRIX_KEY(5, 3, KEY_7)>,	/* 54 7 */
				<MATRIX_KEY(5, 4, KEY_6)>,	/* 55 6 */
				<MATRIX_KEY(5, 5, KEY_5)>,	/* 56 5 */
				<MATRIX_KEY(5, 6, KEY_4)>,	/* 57 4 */
				<MATRIX_KEY(5, 7, KEY_3)>,	/* 58 3 */
				<MATRIX_KEY(5, 8, KEY_F3)>,	/* 59 F3 */
				<MATRIX_KEY(5, 9, KEY_F2)>,	/* 60 F2 */
				<MATRIX_KEY(6, 0, KEY_F11)>,	/* 61 F11 */
				<MATRIX_KEY(6, 1, KEY_F10)>,	/* 62 F10 */
				<MATRIX_KEY(6, 2, KEY_F9)>,	/* 63 F9 */
				<MATRIX_KEY(6, 3, KEY_F8)>,	/* 64 F8 */
				<MATRIX_KEY(6, 4, KEY_F7)>,	/* 65 F7 */
				<MATRIX_KEY(6, 5, KEY_F6)>,	/* 66 F6 */
				<MATRIX_KEY(6, 6, KEY_F5)>,	/* 67 F5 */
				<MATRIX_KEY(6, 7, KEY_F4)>;	/* 68 F4 */
			// END generated by tools/keyboard-base-keymap.py
			};

			// XL9555 expander (task 3.3), register-compatible with the
			// PCA9555. Its INT line's wiring is unknown, so no interrupt.
			kbd_expander: gpio@20 {
				compatible = "nxp,pca9555";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};

			// BQ27220 fuel gauge (task 5.1); read-only in bq27xxx.
			fuel-gauge@55 {
				compatible = "ti,bq27220";
				reg = <0x55>;
			};

			// BQ25896 charger (tasks 5.2, 5.2a). INT reaches no SoC GPIO,
			// so there is no interrupts property and the patched driver
			// polls. skip-reset and read-back-settings keep the charge
			// parameters the chip already holds; the values below are those
			// same register values (docs/evidence/keyboard-base/charger/),
			// for the binding only.
			charger@6b {
				compatible = "ti,bq25896";
				reg = <0x6b>;
				linux,skip-reset;
				linux,read-back-settings;
				ti,battery-regulation-voltage = <4288000>;
				ti,charge-current = <704000>;
				ti,termination-current = <256000>;
				ti,precharge-current = <128000>;
				ti,minimum-sys-voltage = <3500000>;
				ti,boost-voltage = <4998000>;
				ti,boost-max-current = <1400000>;
				ti,thermal-regulation-threshold = <120>;
			};
		};
	};
};

// IO43 is the keypad's active-low reset. The probe found it high with the
// keypad answering (docs/evidence/keyboard-base/probe/); the driver has no
// reset property, so the line is held released here.
&gpio1_ports {
	tca8418-reset-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "kbd-tca8418-reset";
	};
};

// nRF9151 on the keyboard base (openspec/changes/
// the-nrf9151-gives-the-handheld-cellular-sms-and-location). IO2 enables its
// 3.3 V supply (LILYGO rt_sample_display.cpp, "nRF9151 enable 3.3v");
// stage 1 leaves IO2 on JTAG_TCK with output disabled, so it is muxed to
// GPIO here and left for the modem service to drive. UART3 moves from
// IO50/IO51, where stage 1 puts it, to IO28/IO29 function 2 (LILYGO patch
// 0061); IO50/IO51 are released as inputs so only one pad pair feeds RXD.
&pinctrl {
	uart3_nrf_pins: uart3-nrf-pins {
		uart3-txd-cfg {
			pinmux = <K230_PINMUX(28, 2)>;
			drive-strength = <4>;
			power-source = <K230_MSC_3V3>;
			output-enable;
			bias-disable;
		};

		uart3-rxd-cfg {
			pinmux = <K230_PINMUX(29, 2)>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			bias-pull-up;
		};

		uart3-io50-io51-release-cfg {
			pinmux = <K230_PINMUX(50, 0)>, <K230_PINMUX(51, 0)>;
			power-source = <K230_MSC_3V3>;
			input-enable;
			bias-pull-down;
		};
	};

	nrf9151_en_pins: nrf9151-en-pins {
		nrf9151-en-cfg {
			pinmux = <K230_PINMUX(2, 0)>;
			drive-strength = <8>;
			power-source = <K230_MSC_3V3>;
			output-enable;
			input-enable;
			bias-disable;
		};
	};
};

/ {
	aliases {
		serial3 = &uart3;
	};
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_nrf_pins>, <&nrf9151_en_pins>;
	status = "okay";
};

// Named so the modem service finds the enable line by name
// (gpioset nrf9151-enable=1, libgpiod 2) rather than by offset.
&gpio0_ports {
	gpio-line-names =
		"", "", "nrf9151-enable", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

// Keyboard base LEDs. P0.3-P0.5 of the XL9555 are active low: LILYGO's
// RT-Smart driver writes 0xF7 to light Caps Lock (P0.3) and its Linux UI
// writes 0 to light each one (keyboard_ext.c, ui_hardware.c xl9555_set_led).
// IO52, the key backlight, is a pwm-leds entry below (task 4.2); the
// operator saw it light as an active-high GPIO (task 4.1).
/ {
	keyboard-base-leds {
		compatible = "gpio-leds";

		led-capslock {
			label = "k230:green:capslock";
			gpios = <&kbd_expander 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-status-1 {
			label = "k230:status-1";
			gpios = <&kbd_expander 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-status-2 {
			label = "k230:status-2";
			gpios = <&kbd_expander 5 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

	};

	// 20 kHz, above hearing. NORMAL polarity assumes the driver's reading of
	// the comparator (pwm-k230.c header, UNVERIFIED); if brightness 0 lights
	// the keys, PWM_POLARITY_INVERTED here flips it without a kernel change.
	keyboard-base-backlight {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&kbd_backlight_pins>;

		led-kbd-backlight {
			label = "k230::kbd_backlight";
			pwms = <&pwm1 1 50000 0>;
			max-brightness = <255>;
			default-state = "off";
		};
	};
};
