// SPDX-License-Identifier: GPL-2.0 OR MIT
// LILYGO T-Display-K230.
//
// Derived from canaan/k230-canmv-v3-lcd.dts, which is the reference this
// board is a variant of -- U-Boot on our hardware prints
// "Model: kendryte k230 canmv v3.0". Every divergence from that reference
// is marked DIVERGENCE below and listed in
// docs/evidence/dts-divergence.md.
//
// UNVERIFIED: this has never been booted.

/dts-v1/;

#include "k230.dtsi"
#include "display-rm69a10-568x1232.dtsi"

/ {
	model = "LILYGO T-Display-K230";
	compatible = "lilygo,t-display-k230", "canaan,canmv-k230", "canaan,kendryte-k230";

	aliases {
		serial3 = &uart3;
		// DIVERGENCE (naming only): on this board mmc0 carries the
		// RTL8189FTV over SDIO and mmc1 carries the TF card. The
		// reference names them the same way; recorded because
		// docs/findings.md originally had them swapped.
		mmc0 = &mmc_sd0;
		mmc1 = &mmc_sd1;
		i2c0 = &i2c4;
		i2c1 = &i2c3;
	};

	chosen {
		// Linux console. Note U-Boot's own console is ttyS1 per the
		// SDK environment; the two legitimately differ.
		stdout-path = "serial0:115200n8";
	};

	ddr: memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	sound {
		status                      = "okay";
		compatible                  = "canaan,k230-audio-inno";
		canaan,model                = "K230_I2S_INNO";
		canaan,k230-i2s-controller  = <&i2s>;
		canaan,k230-audio-codec     = <&inno_codec>;
	};
};

&uart0 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

// The TF card.
&mmc_sd1 {
	status = "okay";
	no-1-8-v;
	cap-sd-highspeed;
	mshc_ctrl_r = <0x00>;
};

// The RTL8189FTV, over SDIO.
&mmc_sd0 {
	status = "okay";
	no-1-8-v;
	rx_delay_line = <0x0d>;
	tx_delay_line = <0xc0>;
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&i2c3 {
	status = "okay";

	// DIVERGENCE: the reference fits an edt,edt-ft5306 at 0x38. This
	// board has a Goodix GT9895 at 0x5d -- a Berlin-generation part,
	// which the pinned 6.6 tree does not support. The driver arrives as
	// a backport in this change; without it this node simply does not
	// probe and the panel still works.
	//
	// The GPIOs are the same as the reference's touch controller:
	// RST on 24, INT on 23. Confirmed against the schematic.
	touchscreen@5d {
		compatible = "goodix,gt9895";
		reg = <0x5d>;
		reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0_ports>;
		interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
	};
};

&i2c4 {
	status = "okay";
};

&mipi0 {
	// set to csi2
	id = <2>;
	reg = <0x0 0x9000a800 0x0 0x800>;
	interrupts = <121 IRQ_TYPE_LEVEL_HIGH>;
	resets = <&sysctl_reset K230_RESET_CSI2_REG_OFFSET K230_RESET_CSI2_TYPE
			  K230_RESET_CSI2_DONE_BIT K230_RESET_CSI2_ASSERT_BIT>,
	<&sysctl_reset K230_RESET_M2_REG_OFFSET K230_RESET_M2_TYPE
		 K230_RESET_M2_DONE_BIT K230_RESET_M2_ASSERT_BIT>;
};

// Reset and backlight for the panel. `lcd` is the label on the panel node
// in display-rm69a10-568x1232.dtsi; the panel dtsi deliberately carries no
// GPIOs of its own, matching how the reference splits panel from board.
//
// GPIO22 reset is ACTIVE_HIGH and GPIO25 is the backlight -- both taken
// from k230-canmv-v3-lcd.dts, and both were unestablished before that.
&lcd {
	dsi_reset-gpios = <&gpio0_ports 22 GPIO_ACTIVE_HIGH>;
	backlight_gpio-gpios = <&gpio0_ports 25 GPIO_ACTIVE_HIGH>;
};
