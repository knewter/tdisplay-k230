// SPDX-License-Identifier: GPL-2.0 OR MIT
// LILYGO T-Display-K230.
//
// Derived from canaan/k230-canmv-v3-lcd.dts, which is the reference this
// board is a variant of -- U-Boot on our hardware prints
// "Model: kendryte k230 canmv v3.0". Every divergence from that reference
// is marked DIVERGENCE below and listed in
// docs/evidence/dts-divergence.md.
//
// UNVERIFIED: this has never been booted.

/dts-v1/;

#include "k230.dtsi"
#include "display-rm69a10-568x1232.dtsi"

/ {
	model = "LILYGO T-Display-K230";
	compatible = "lilygo,t-display-k230", "canaan,canmv-k230", "canaan,kendryte-k230";

	aliases {
		serial3 = &uart3;
		// DIVERGENCE (naming only): on this board mmc0 carries the
		// RTL8189FTV over SDIO and mmc1 carries the TF card. The
		// reference names them the same way; recorded because
		// docs/findings.md originally had them swapped.
		mmc0 = &mmc_sd0;
		mmc1 = &mmc_sd1;
		i2c0 = &i2c4;
		i2c1 = &i2c3;
	};

	chosen {
		// Linux console. Note U-Boot's own console is ttyS1 per the
		// SDK environment; the two legitimately differ.
		stdout-path = "serial0:115200n8";
	};

	ddr: memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	// DIVERGENCE: stage 1 scans this XRGB buffer until Linux owns the panel.
	// The values come from nix/boot-splash.nix through device-tree.nix's
	// preprocessor definitions, shared with U-Boot's Kconfig fragment.
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		splash_framebuffer: framebuffer@K230_SPLASH_FRAMEBUFFER_UNIT_ADDRESS {
			reg = <0x0 K230_SPLASH_FRAMEBUFFER_ADDRESS
			       0x0 K230_SPLASH_FRAMEBUFFER_SIZE>;
			no-map;
		};
	};

	sound {
		status                      = "okay";
		compatible                  = "canaan,k230-audio-inno";
		canaan,model                = "K230_I2S_INNO";
		canaan,k230-i2s-controller  = <&i2s>;
		canaan,k230-audio-codec     = <&inno_codec>;
	};
};

&uart0 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

// The TF card.
&mmc_sd1 {
	status = "okay";
	no-1-8-v;
	cap-sd-highspeed;
	mshc_ctrl_r = <0x00>;
};

// The RTL8189FTV, over SDIO.
&mmc_sd0 {
	status = "okay";
	no-1-8-v;
	rx_delay_line = <0x0d>;
	tx_delay_line = <0xc0>;
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&i2c3 {
	status = "okay";

	// DIVERGENCE: the reference fits an edt,edt-ft5306 at 0x38. This
	// board has a Goodix GT9895 at 0x5d -- a Berlin-generation part,
	// which the pinned 6.6 tree does not support. The driver arrives as
	// a backport in this change; without it this node simply does not
	// probe and the panel still works.
	//
	// The GPIOs are the same as the reference's touch controller:
	// RST on 24, INT on 23. Confirmed against the schematic.
	//
	// Two compatibles, most-specific first, which is how a fallback is
	// meant to be written. The part really is a GT9895, and that string
	// is what a driver gaining real GT9895 support would match on. But
	// the backported goodix_berlin matches ONLY "goodix,gt9916" --
	// nix/patches/goodix-berlin/goodix_berlin_i2c.c:57 -- so with the
	// specific string alone nothing binds and the experiment task 4.1
	// asks for cannot even run. The fallback lets the Berlin driver
	// attach while the device tree keeps telling the truth about the
	// silicon.
	//
	// It is close enough: the backport binds, reads the firmware version
	// and the IC-info blob without error, and derives touch_data_addr
	// from the part at runtime. See docs/evidence/gt9895-port.md.
	touchscreen@5d {
		compatible = "goodix,gt9895", "goodix,gt9916";
		reg = <0x5d>;
		reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0_ports>;

		// LEVEL_LOW, not EDGE_FALLING.
		//
		// EDGE_FALLING was inherited from the reference board's
		// edt-ft5306 (k230-canmv-v3-lcd.dts:66), a different part,
		// and it is why touch bound but reported nothing: four
		// interrupts on IRQ 87 since boot and then silence, with a
		// live controller answering i2c. A Goodix Berlin part holds
		// INT asserted low until the host clears the status byte at
		// touch_data_addr; goodix_berlin_irq() returns early WITHOUT
		// clearing whenever it reads status == 0
		// (nix/patches/goodix-berlin/goodix_berlin_core.c:566), so
		// one such early return leaves the line low forever and an
		// edge detector never sees another falling edge. A level
		// detector re-asserts immediately and the handler clears it.
		//
		// caveman99/k230-linux runs this same backported driver on
		// this same 6.6.36 tree on this same board with
		// IRQ_TYPE_LEVEL_LOW and reports working multitouch; its
		// /proc/interrupts line reads "gpio-k230 23 Level
		// goodix-berlin" where ours reads "Edge". gpio-k230 supports
		// both (drivers/gpio/gpio-k230.c:333).
		interrupts = <23 IRQ_TYPE_LEVEL_LOW>;

		// The digitizer grid, not the panel. goodix_berlin declares
		// ABS_MT_POSITION_X/Y max = SZ_64K-1 and then lets
		// touchscreen_parse_properties() override it
		// (goodix_berlin_core.c:621-627); with nothing to read, every
		// touch lands in the top-left 1% of any client that scales by
		// the declared range.
		//
		// 1024 x 2400 has two independent sources: LILYGO's own
		// RT-Smart driver, which divides raw coordinates by exactly
		// these constants
		// (repo/canmv_k230/src/rtsmart/rtsmart/kernel/bsp/maix3/drivers/extdrv/touch/gt9895.c:44-45),
		// and caveman99's Linux port. The panel is 568x1232, so the
		// sensor grid is roughly 1.8x the pixel grid in both axes --
		// same orientation, hence no swapped-x-y or inverted-* here.
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <2400>;
	};
};

&i2c4 {
	status = "okay";
};

&mipi0 {
	// set to csi2
	id = <2>;
	reg = <0x0 0x9000a800 0x0 0x800>;
	interrupts = <121 IRQ_TYPE_LEVEL_HIGH>;
	resets = <&sysctl_reset K230_RESET_CSI2_REG_OFFSET K230_RESET_CSI2_TYPE
			  K230_RESET_CSI2_DONE_BIT K230_RESET_CSI2_ASSERT_BIT>,
	<&sysctl_reset K230_RESET_M2_REG_OFFSET K230_RESET_M2_TYPE
		 K230_RESET_M2_DONE_BIT K230_RESET_M2_ASSERT_BIT>;
};

// Reset and backlight for the panel. `lcd` is the label on the panel node
// in display-rm69a10-568x1232.dtsi; the panel dtsi deliberately carries no
// GPIOs of its own, matching how the reference splits panel from board.
//
// GPIO22 reset is ACTIVE_HIGH and GPIO25 is the backlight -- both taken
// from k230-canmv-v3-lcd.dts, and both were unestablished before that.
&lcd {
	dsi_reset-gpios = <&gpio0_ports 22 GPIO_ACTIVE_HIGH>;
	backlight_gpio-gpios = <&gpio0_ports 25 GPIO_ACTIVE_HIGH>;
};
