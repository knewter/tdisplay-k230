// SPDX-License-Identifier: GPL-2.0
// RM69A10 4.1" 568x1232 AMOLED, as fitted to the LILYGO T-Display-K230.
//
// Structure follows display-st7701-480x800.dtsi exactly: the panel is a
// DSI device inside &dsi, labelled `lcd` so a board .dts can attach its
// reset and backlight GPIOs, with an endpoint graph back to &dsi.
//
// The init sequence is transcribed from the vendor's working RT-Smart
// driver -- all 20 commands, 297 payload bytes. See
// docs/evidence/rm69a10-init-sequence.md, which cites a source line per
// command.
//
// UNVERIFIED: none of this has been run on hardware.

&vo {
	// intr_line from connector_info_list[] for this panel.
	// 10, matching every Canaan board dts in the vendor tree
	// (k230-canmv-01studio*.dts, -dongshanpi.dts, ...). This was 9,
	// which docs/evidence/dts-divergence.md recorded as a divergence
	// without a reason -- and there is no vth_line anywhere in
	// LilyGO's RT-Smart tree to have taken 9 from. An ungrounded
	// divergence in a video timing parameter, on a panel that does not
	// light, is not worth keeping.
	vth_line = <10>;
};

&dsi {
	ports {
		port@1 {
			reg = <1>;
			dsi_out_rm69a10: endpoint {
				remote-endpoint = <&rm69a10_in>;
			};
		};
	};

	lcd: panel@0 {
		compatible = "canaan,universal";
		reg = <0>;

		// DIVERGENCE: the reference puts PIXEL COUNTS in these (480/800 for
		// a 480x800 panel). These are real millimetres, computed from the
		// stated 4.1" diagonal at 568x1232 -- not measured. Only affects the
		// DPI the connector reports.
		panel-width-mm = <44>;
		panel-height-mm = <95>;

		panel-dsi-lane = <2>;

		// framing: data_type, delay_ms, payload_length, payload...
		// delay is u8 MILLIseconds. The vendor waits 300us after 0x11 and
		// 100us after 0x29; neither is expressible, so both become 1 ms,
		// which is longer than the vendor waits.
		panel-init-sequence = [
			15 00 02 fe fd   /* Raydium page select: FE=FD */
			15 00 02 80 fc   /* page FC */
			15 00 02 fe 00   /* back to user page 00 */
			39 00 05 2a 00 00 02 37   /* column address 0..0x237 (567) */
			39 00 05 2b 00 00 04 cf   /* page address 0..0x4cf (1231) */
			39 00 05 31 00 03 02 34   /* partial columns */
			39 00 05 30 00 00 04 cf   /* partial rows */
			15 00 02 12 00   /* enter partial mode */
			15 00 02 35 00   /* tearing effect on */
			15 02 02 51 fe   /* SET_DISPLAY_BRIGHTNESS 0xFE, then 2ms */
			05 78 01 11   /* sleep out, then 120ms */
			05 00 01 29   /* display on */
			15 00 02 3a 77   /* pixel format 0x77 */
		];

		// From connector_info_list[] in mpi_connector.c:
		//   pclk 39600 kHz, phyclk 475200 kHz, 2 lanes, burst mode
		// 39.6 MHz / (788 x 1268) = 39.63 Hz. The vendor enum is named
		// 60FPS and is wrong; the numbers are self-consistent.
		display-timings {
			timing-0 {
				clock-frequency = <39600000>;
				hactive = <568>;
				vactive = <1232>;
				hfront-porch = <40>;
				hback-porch = <140>;
				hsync-len = <40>;
				vfront-porch = <16>;
				vback-porch = <16>;
				vsync-len = <4>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				rm69a10_in: endpoint {
					remote-endpoint = <&dsi_out_rm69a10>;
				};
			};
		};
	};
};
