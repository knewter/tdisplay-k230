// SPDX-License-Identifier: GPL-2.0 OR MIT
// Opt-in display/touch companion to k230-tdisplay-mainline.dts.
// This is compiled only for deviceTreeMainlineDrm; it does not change the
// console-only mainline profile or any vendor/default DTB.

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/canaan,k230-clk.h>
#include <dt-bindings/reset/canaan,k230-rst.h>
#include <dt-bindings/soc/canaan,k230_pm_domains.h>

#include "k230-tdisplay-mainline.dts"

// The K230 upstream clock contract includes the SD AXI, card/block and
// timer gates. Keep base as core for the existing SDHCI max-clock source.
// Only the DRM driver consumes these five clocks; console DT is unchanged.
&mmc_sd1 {
	clocks = <&sysclk K230_HS_SD1_BASE_GATE>,
		 <&sysclk K230_HS_SD1_AHB_GATE>,
		 <&sysclk K230_HS_SD1_AXI_GATE>,
		 <&sysclk K230_HS_SD1_CARD_GATE>,
		 <&sysclk K230_HS_SD1_TIMER_GATE>;
	clock-names = "core", "bus", "axi", "block", "timer";
};

// Same five-clock claim for the RTL8189FTV's SDIO controller (task
// the-mainline-shell-reaches-parity 6.1). nix/patches/mainline/
// k230-sdhci-clocks.patch's dwcmshc_probe()/devm_clk_bulk_get() path is
// generic over every "canaan,k230-dw-mshc" instance, not SD1-specific (the
// three extra clk_bulk_data entries are requested by whichever device probes
// the shared driver) -- so &mmc_sd0 needs the identical override, not a
// smaller one, once this DRM kernel's patched driver is the one binding it.
// The base k230-tdisplay-mainline.dts node still claims only core/bus so the
// unpatched console driver's two devm_clk_get() calls keep matching exactly.
&mmc_sd0 {
	clocks = <&sysclk K230_HS_SD0_BASE_GATE>,
		 <&sysclk K230_HS_SD0_AHB_GATE>,
		 <&sysclk K230_HS_SD0_AXI_GATE>,
		 <&sysclk K230_HS_SD0_CARD_GATE>,
		 <&sysclk K230_HS_SD0_TIMER_GATE>;
	clock-names = "core", "bus", "axi", "block", "timer";
};

// The RTC sits in the PMU block behind the PMU APB gate, which mainline
// otherwise gates as unused; the RTC driver enables it from probe.
&rtc {
	clocks = <&sysclk K230_PMU_APB_GATE>;
	clock-names = "pclk";
};

// Mainline's k230.dtsi currently has no display or I2C controller nodes.
// Register ranges, VO/DSI IRQ, and I2C3 range/IRQ follow the pinned vendor
// k230.dtsi (7d4e1f444f461dbe3833bd99a4640e7b6c2cd529). The K230 mainline
// clock driver exposes the named display and LS-I2C clocks in the included
// binding header. The imported Canaan VO/DSI code does not call clk_get() or
// reset_control_get(); it programs its display/PHY registers directly, so
// this DTS does not attach unused, guessed clock/reset phandles to those
// nodes. I2C3 uses the mainline I2C3 functional and APB clocks; its reset ID
// is available but the generic DesignWare I2C driver does not consume it.
// Board-level clocking, reset timing, pinmux, and display power behavior
// still require physical probe evidence.

/ {
	soc {
		// Vendor genpd controller; available only with the DRM kernel port.
		sysctl_power: power-controller@91103000 {
			compatible = "canaan, k230-sysctl-power";
			reg = <0x0 0x91103000 0x0 0x1000>;
			#power-domain-cells = <1>;
		};
		// Panel touch: vendor k230.dtsi's i2c3 controller node translated
		// to the real mainline K230 clock provider IDs. Upstream's DW I2C
		// platform driver accepts an unnamed functional clock and an
		// optional "pclk" interface clock.
		i2c3: i2c@91408000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x91408000 0x0 0x1000>;
			interrupts = <24 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sysclk K230_LS_I2C3_RATE>,
				 <&sysclk K230_LS_I2C3_APB_GATE>;
			clock-names = "ref", "pclk";
			clock-frequency = <400000>;
			status = "okay";

			touchscreen@5d {
				compatible = "goodix,gt9895", "goodix,gt9916";
				reg = <0x5d>;
				reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_LOW>;
				interrupt-parent = <&gpio0_ports>;
				interrupts = <23 IRQ_TYPE_LEVEL_LOW>;
				touchscreen-size-x = <1024>;
				touchscreen-size-y = <2400>;
			};
		};

		vo: vo@90840000 {
			compatible = "canaan,k230-vo";
			reg = <0x0 0x90840000 0x0 0x10000>;
			interrupts = <133 IRQ_TYPE_LEVEL_HIGH>;
			// Mainline gate ops let unused-clock cleanup turn these off;
			// the VO and DSI drivers must own them. Same 0x74 gates as
			// the vendor disp_hclk/disp_aclk/dpipclk tree.
			clocks = <&sysclk K230_DISPLAY_AHB_GATE>,
				 <&sysclk K230_DISPLAY_AXI_GATE>,
				 <&sysclk K230_DISPLAY_DPIP_GATE>;
			clock-names = "ahb", "axi", "pixel";
			status = "okay";
			background = <0xffffff>;
			vth_line = <10>;

			vo_out: port {
				#address-cells = <1>;
				#size-cells = <0>;
				vop_out_dsi: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dsi_in_vop>;
				};
			};
		};

		dsi: dsi@90850000 {
			compatible = "canaan,k230-mipi-dsi";
			reg = <0x0 0x90850000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sysclk K230_DISPLAY_AHB_GATE>,
				 <&sysclk K230_DISPLAY_CFG_GATE>,
				 <&sysclk K230_DISPLAY_REF_GATE>;
			clock-names = "ahb", "cfg", "ref";
			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					dsi_in_vop: endpoint {
						remote-endpoint = <&vop_out_dsi>;
					};
				};
			};
		};
	};
};

// This logical DRM subsystem is not a child of the simple-bus SoC node: it
// has no MMIO range of its own. The VO endpoint is described below it.
/ {
	display: display-subsystem {
		compatible = "canaan,display-subsystem";
		power-domains = <&sysctl_power K230_PM_DOMAIN_DISP>;
		ports = <&vo_out>;
		status = "okay";
	};
};

#include "display-rm69a10-568x1232.dtsi"

&gpio0 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&lcd {
	dsi_reset-gpios = <&gpio0_ports 22 GPIO_ACTIVE_HIGH>;
	backlight_gpio-gpios = <&gpio0_ports 25 GPIO_ACTIVE_HIGH>;
};
