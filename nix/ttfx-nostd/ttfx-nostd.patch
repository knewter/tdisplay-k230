index ce82972..14d1ca5 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -5,11 +5,68 @@ edition = "2021"
 description = "Terminal text effects — a Rust port of terminaltexteffects (TTE)"
 license = "MIT"
 
+[[bin]]
+name = "ttfx"
+path = "src/main.rs"
+required-features = ["cli"]
+
+[features]
+default = ["std", "cli", "all-effects"]
+# One feature per effect for `build_default` (the CLI always has them all):
+# firmware builds pick a few to keep the image small.
+all-effects = ["effect-beams", "effect-binarypath", "effect-blackhole", "effect-bouncyballs", "effect-bubbles", "effect-burn", "effect-colorshift", "effect-crumble", "effect-decrypt", "effect-errorcorrect", "effect-expand", "effect-fireworks", "effect-highlight", "effect-laseretch", "effect-matrix", "effect-middleout", "effect-orbittingvolley", "effect-overflow", "effect-pour", "effect-print", "effect-rain", "effect-randomsequence", "effect-rings", "effect-scattered", "effect-slice", "effect-slide", "effect-smoke", "effect-spotlights", "effect-spray", "effect-swarm", "effect-sweep", "effect-synthgrid", "effect-thunderstorm", "effect-unstable", "effect-vhstape", "effect-waves", "effect-wipe"]
+effect-beams = []
+effect-binarypath = []
+effect-blackhole = []
+effect-bouncyballs = []
+effect-bubbles = []
+effect-burn = []
+effect-colorshift = []
+effect-crumble = []
+effect-decrypt = []
+effect-errorcorrect = []
+effect-expand = []
+effect-fireworks = []
+effect-highlight = []
+effect-laseretch = []
+effect-matrix = []
+effect-middleout = []
+effect-orbittingvolley = []
+effect-overflow = []
+effect-pour = []
+effect-print = []
+effect-rain = []
+effect-randomsequence = []
+effect-rings = []
+effect-scattered = []
+effect-slice = []
+effect-slide = []
+effect-smoke = []
+effect-spotlights = []
+effect-spray = []
+effect-swarm = []
+effect-sweep = []
+effect-synthgrid = []
+effect-thunderstorm = []
+effect-unstable = []
+effect-vhstape = []
+effect-waves = []
+effect-wipe = []
+# The std terminal runner (fx engine, ANSI writer, signals, clock).
+std = []
+# `no_std` + alloc build of the engine: hash containers and float functions
+# from hashbrown and libm.  Use with --no-default-features.
+nostd = ["dep:hashbrown", "dep:libm"]
+# The command-line interface and the clap derives on effect configs.
+cli = ["std", "dep:clap", "dep:clap_complete", "dep:terminal_size"]
+
 [dependencies]
-clap = { version = "4", features = ["derive"] }
-clap_complete = "4.6.9"
-terminal_size = "0.4"
+clap = { version = "4", features = ["derive"], optional = true }
+clap_complete = { version = "4.6.9", optional = true }
+terminal_size = { version = "0.4", optional = true }
 unicode-width = "0.2"
+hashbrown = { version = "0.15", default-features = false, optional = true }
+libm = { version = "0.2", optional = true }
 
 [profile.release]
 lto = true
