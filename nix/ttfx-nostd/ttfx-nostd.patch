+//! Platform seams: the hash containers, which `no_std` takes from hashbrown.
+#[cfg(feature = "std")]
+pub use std::collections::{hash_map, HashMap, HashSet};
+#[cfg(not(feature = "std"))]
+pub use hashbrown::hash_map;
+/// hashbrown without its default hasher (which wants a random seed): the same
+/// deterministic FxHasher the engine already uses for its keyed tables.
+#[cfg(not(feature = "std"))]
+pub type HashMap<K, V, S = crate::utils::hash::FxBuild> = hashbrown::HashMap<K, V, S>;
+#[cfg(not(feature = "std"))]
+pub type HashSet<K, S = crate::utils::hash::FxBuild> = hashbrown::HashSet<K, S>;
+
+/// A lazily initialised static for single-threaded targets (stage 1 firmware
+/// runs one thread). `Sync` is asserted, not earned: do not use from threads.
+#[cfg(not(feature = "std"))]
+pub struct Tls<T> {
+    cell: core::cell::UnsafeCell<Option<T>>,
+    init: fn() -> T,
+}
+#[cfg(not(feature = "std"))]
+unsafe impl<T> Sync for Tls<T> {}
+#[cfg(not(feature = "std"))]
+impl<T> Tls<T> {
+    pub const fn new(init: fn() -> T) -> Self {
+        Tls { cell: core::cell::UnsafeCell::new(None), init }
+    }
+    pub fn with<R>(&'static self, f: impl FnOnce(&T) -> R) -> R {
+        // SAFETY: single-threaded by contract; `f` may not re-enter `with` on
+        // the same Tls before the slot is initialised (the std version has
+        // the same restriction).
+        let slot = unsafe { &mut *self.cell.get() };
+        if slot.is_none() {
+            *slot = Some((self.init)());
+        }
+        f(slot.as_ref().unwrap())
+    }
+}
+
+/// `thread_local!` with `std`, a single-threaded static [`Tls`] without it.
+#[cfg(feature = "std")]
+#[macro_export]
+macro_rules! thread_local_compat {
+    ($($t:tt)*) => { ::std::thread_local! { $($t)* } };
+}
+#[cfg(not(feature = "std"))]
+#[macro_export]
+macro_rules! thread_local_compat {
+    () => {};
+    ($(#[$m:meta])* static $name:ident : $ty:ty = const { $init:expr } ; $($rest:tt)*) => {
+        $(#[$m])* static $name: $crate::sys::Tls<$ty> = $crate::sys::Tls::new(|| $init);
+        $crate::thread_local_compat! { $($rest)* }
+    };
+    ($(#[$m:meta])* static $name:ident : $ty:ty = $init:expr ; $($rest:tt)*) => {
+        $(#[$m])* static $name: $crate::sys::Tls<$ty> = $crate::sys::Tls::new(|| $init);
+        $crate::thread_local_compat! { $($rest)* }
+    };
+}
+
+#[cfg(feature = "std")]
+pub use std::sync::OnceLock;
+/// `OnceLock` for single-threaded targets.
+#[cfg(not(feature = "std"))]
+pub struct OnceLock<T>(core::cell::UnsafeCell<Option<T>>);
+#[cfg(not(feature = "std"))]
+unsafe impl<T> Sync for OnceLock<T> {}
+#[cfg(not(feature = "std"))]
+impl<T> OnceLock<T> {
+    pub const fn new() -> Self {
+        OnceLock(core::cell::UnsafeCell::new(None))
+    }
+    pub fn get_or_init(&self, f: impl FnOnce() -> T) -> &T {
+        // SAFETY: single-threaded by contract.
+        let slot = unsafe { &mut *self.0.get() };
+        if slot.is_none() {
+            *slot = Some(f());
+        }
+        slot.as_ref().unwrap()
+    }
+}
