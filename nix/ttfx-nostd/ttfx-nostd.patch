+/// `ESC [ <n> <final>`, without `fmt`/`io` so this builds without std.
+fn push_csi(out: &mut Vec<u8>, n: usize, last: u8) {
+    out.extend_from_slice(b"\x1b[");
+    let mut digits = [0u8; 20];
+    let mut at = digits.len();
+    let mut v = n;
+    loop {
+        at -= 1;
+        digits[at] = b'0' + (v % 10) as u8;
+        v /= 10;
+        if v == 0 {
+            break;
+        }
+    }
+    out.extend_from_slice(&digits[at..]);
+    out.push(last);
+}
