# Upstream LilyGO SDK clone (2.5 GB) — fetch with tools/fetch-sdk.sh
/repo/

# Firmware images and build output
*.img
*.zip
fw/
build/
result
result-*

# Local scratch
*.pdf
.build/

# Spec site: everything under site/ that the build regenerates
/site/node_modules/
/site/dist/
/site/.astro/
/site/src/data/specs.json
/site/public/evidence/

# Python bytecode
__pycache__/
*.pyc

# Stage-1 firmware binaries are NOT committed. They are built by
# tools/gen-stage1.sh (locally) or by .github/workflows/stage1.yml (CI,
# which publishes them to a release), and nix/stage1.nix fetches them by
# hash. firmware/stage1/PROVENANCE.txt stays tracked and records what they
# are and where they came from.
/firmware/stage1/*.bin
/firmware/stage1/*.env
