# Upstream LilyGO SDK clone (2.5 GB) — fetch with tools/fetch-sdk.sh
/repo/

# Firmware images and build output
*.img
*.zip
fw/
build/
result
result-*

# Local scratch
*.pdf
.build/

# Spec site: everything under site/ that the build regenerates
/site/node_modules/
/site/dist/
/site/.astro/
/site/src/data/specs.json
/site/public/evidence/

# Python bytecode
__pycache__/
*.pyc

# Stage 1 is built from source by the flake (nix/stage1.nix); nothing
# binary lives in firmware/stage1/ except the vendor-compiled fallback
# that tools/gen-stage1.sh drops here for bisecting, which stays out of
# git. firmware/stage1/PROVENANCE.txt and tdisplay.env are text and tracked.
/firmware/stage1/*.bin
/firmware/stage1/env.env
result-sd-image
