---
import Base from "../../layouts/Base.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { specs, url, kib } from "../../lib/specs";
import { evidenceMarkdownLinks, rawEvidenceUrl } from "../../lib/evidence-markdown";

export function getStaticPaths() {
  return specs.evidence.map((file) => ({
    params: { slug: file.slug },
    props: { file },
  }));
}

const { file } = Astro.props;
const markdown = file.kind === "text" && file.path.toLowerCase().endsWith(".md")
  ? (await (await createMarkdownProcessor({
      syntaxHighlight: false,
      remarkRehype: { allowDangerousHtml: false },
      rehypePlugins: [evidenceMarkdownLinks(file.path, specs.evidence, import.meta.env.BASE_URL, specs.sourceRevision)],
    })).render(file.text ?? "")).code
  : null;
---

<Base title={`${file.name} — evidence`} description={`Committed evidence at ${file.path}.`}>
  <nav class="crumbs">
    <a href={url("")}>&larr; all capabilities</a>
    <span class="mono dim">{file.path}</span>
  </nav>

  <header class="cap-head">
    <p class="eyebrow">evidence &middot; {kib(file.bytes)}</p>
    <h1>{file.name}</h1>
    <p class="purpose mono dim">
      Committed at <code>{file.path}</code>. This is what grounds the requirements
      that cite it.
    </p>
    {file.kind === "text" && <p class="ev-source"><a href={rawEvidenceUrl(specs.sourceRevision, file.path)}>Open raw source</a></p>}
  </header>

  {
    file.kind === "image" ? (
      <div class="ev-image">
        <img src={url(file.asset!)} alt={file.path} />
      </div>
    ) : file.kind === "video" ? (
      <section class="ev-media">
        <p>
          This recording stays outside the static-site bundle. Its committed bytes and SHA-256
          remain recorded in <code>docs/blob-inventory.md</code>.
        </p>
        <a class="media-link" href={file.mediaUrl}>Open the pinned raw video</a>
      </section>
    ) : markdown !== null ? (
      <article class="ev-markdown" set:html={markdown} />
    ) : (
      <pre class="ev-text">{file.text}</pre>
    )
  }
</Base>
