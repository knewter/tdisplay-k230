---
import Base from "../../layouts/Base.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import work from "../../data/work.json";
import { specs, url } from "../../lib/specs";
import { rawEvidenceUrl } from "../../lib/evidence-markdown";
import { workMarkdownLinks } from "../../lib/work-markdown";

const names: Record<string, { title: string; hint: string }> = {
  planned: { title: "Planned", hint: "A committed proposal. Work and proof have not started in this snapshot." },
  "in-progress": { title: "In progress", hint: "Implementation or investigation is underway; acceptance remains open." },
  verification: { title: "Verification & review", hint: "Source or tasks advanced; the named review or evidence gate still matters." },
  archived: { title: "Archived", hint: "The OpenSpec change closed. This does not certify unrelated device features." },
};
const byId = Object.fromEntries(work.items.map((item) => [item.id, item]));
const sourceLabel: Record<string, string> = {
  "not-started": "Source: not started",
  "in-progress": "Source: in progress",
  "source-landed": "Source: landed checkpoint",
  archived: "Change: archived",
};
const physicalLabel: Record<string, string> = {
  "not-applicable": "Proof: see linked records",
  "not-recorded": "Device proof: see tasks",
  pending: "Device proof: pending",
  verified: "Device proof: verified for cited scope",
};
const github = (path: string) => `https://github.com/knewter/tdisplay-k230/blob/${work.sourceRevision}/${path}`;
const evidenceLink = (path: string) => {
  const local = specs.evidence.find((file) => file.path === path);
  return local ? url(`evidence/${local.slug}/`) : rawEvidenceUrl(work.sourceRevision, path);
};
const mediaSource = (path: string) => {
  const file = specs.evidence.find((entry) => entry.path === path);
  return file?.asset ? url(file.asset) : rawEvidenceUrl(work.sourceRevision, path);
};
const artifactName = (path: string) => path.split("/").slice(-2).join(" / ");
const DetailTemplate = "template";
const artifactPaths = [...new Set(work.items.flatMap((item) => [...item.evidence, ...item.details.map((doc) => doc.path)]))];
const artifactIndex = artifactPaths.map((path) => [path, specs.evidence.find((file) => file.path === path)?.slug ?? null]);
const accepted = (path: string) => {
  const parts = path.split("/");
  return url(`c/${parts[2]}-${parts[3]}/`);
};
const documents = work.items.flatMap((item) => item.details.map((doc, section) => ({
  path: doc.path, workId: item.id, section,
})));
const items = await Promise.all(work.items.map(async (item) => ({
  ...item,
  rendered: await Promise.all(item.details.map(async (doc) => {
    const processor = await createMarkdownProcessor({
      syntaxHighlight: false,
      remarkRehype: { allowDangerousHtml: false },
      rehypePlugins: [workMarkdownLinks(doc.path, specs.evidence, documents, work.trackedPaths, import.meta.env.BASE_URL, work.sourceRevision)],
    });
    return { ...doc, html: (await processor.render(doc.markdown)).code };
  })),
})));
---

<Base title="Project work board · K230" source="work" description="A dated, evidence-aware snapshot of planned, active, verification and archived K230 work.">
  <main class="work-page">
    <nav class="work-breadcrumb" aria-label="Breadcrumb"><a href={url("")}>Verification ledger</a><span aria-hidden="true">/</span><span>Work board</span></nav>
    <header class="work-intro">
      <p class="work-kicker">K230 · public project snapshot</p>
      <h1>What remains, and what is proven.</h1>
      <p class="work-lede">Follow each change from proposal to evidence. The lanes reflect committed work at this revision, not a live agent feed. A checked task, landed source, archived plan, and verified device behavior are different claims.</p>
      <div class="work-meta"><span>As of <strong>{work.generated}</strong></span><span>Revision <a href={`https://github.com/knewter/tdisplay-k230/commit/${work.sourceRevision}`}><code>{work.sourceRevision.slice(0, 12)}</code></a></span><span>Source: {work.sourceMode}</span></div>
    </header>

    <nav class="work-jump" aria-label="Work lanes">
      {work.lanes.map((lane) => <a href={`#${lane.id}`}><span>{names[lane.id].title}</span><b>{lane.count}</b></a>)}
    </nav>

    <div class="work-grid">
      {work.lanes.map((lane) => <section class={`work-lane lane-${lane.id}`} id={lane.id} aria-labelledby={`${lane.id}-title`}>
        <div class="lane-head"><span class="lane-mark" aria-hidden="true"></span><div><h2 id={`${lane.id}-title`}>{names[lane.id].title}<span class="lane-count">{lane.count}</span></h2><p>{names[lane.id].hint}</p></div></div>
        <div class="lane-items">
          {items.filter((item) => item.lane === lane.id).map((item) => <article class="work-card" id={item.id}>
            {item.media[0] && <figure class="card-cover">
              {item.media[0].kind === "image"
                ? <img src={mediaSource(item.media[0].path)} alt={item.media[0].caption} loading="lazy" decoding="async" />
                : <video src={mediaSource(item.media[0].path)} preload="metadata" muted playsinline aria-label={item.media[0].caption} />}
              <figcaption><span>{item.media[0].kind === "video" ? "▶ Video" : "Image"} · {item.media[0].provenance}</span><span>{item.media.length} media</span></figcaption>
            </figure>}
            <div class="card-top"><span class="card-kind">{item.archived ? "Archived change" : "Draft proposal"}</span><span class="card-count">{item.done}/{item.total} tasks</span></div>
            {item.evidence.length > 0 && <details class="card-evidence">
              <summary>Evidence <span>{item.evidence.length}</span></summary>
              <nav aria-label={`Evidence for ${item.title}`}>
                {item.evidence.map((path) => <a href={evidenceLink(path)}>{artifactName(path)}</a>)}
              </nav>
            </details>}
            <a class="card-primary" data-work-id={item.id} href={`${url("work/")}?work=${encodeURIComponent(item.id)}`} aria-haspopup="dialog"><h3>{item.title}</h3></a>
            <div class="card-progress" role="img" aria-label={`${item.done} of ${item.total} tasks checked`}><span style={`width:${item.total ? Math.round(100 * item.done / item.total) : 0}%`}></span></div>
            <div class="card-states"><span>{sourceLabel[item.source]}</span><span>{physicalLabel[item.physical]}</span></div>
            <div class="card-next"><strong>{item.archived ? "Closed record" : "Next gate"}</strong><p>{item.next}</p></div>
          </article>)}
        </div>
      </section>)}
    </div>
    <aside class="work-notes"><h2>How to read this board</h2><p>Task counts come from committed OpenSpec checkboxes. Reviewed status notes distinguish landed source from physical proof where the checklist alone cannot. “Archived” describes a closed change and its cited scope; it is not a claim that every related feature ships in the current image. Open proposals are drafts and never enter the <a href={url("")}>accepted requirement count</a>.</p></aside>
  </main>
  <dialog id="work-detail-dialog" class="work-dialog" aria-label="Work item details">
    <div class="dialog-frame"><header class="dialog-bar"><span>Project work · committed detail</span><button id="work-detail-close" type="button">Close <span aria-hidden="true">×</span></button></header><div id="work-detail-content" class="dialog-scroll"></div></div>
  </dialog>
  <dialog id="work-media-dialog" class="media-dialog" aria-label="Evidence gallery">
    <div class="media-frame">
      <header class="media-bar"><span id="media-position" aria-live="polite"></span><button id="media-close" type="button" aria-label="Close gallery">Close ×</button></header>
      <div class="media-stage" id="media-stage">
        <img id="media-image" alt="" hidden />
        <video id="media-video" controls preload="none" playsinline hidden />
      </div>
      <footer class="media-footer">
        <button id="media-previous" type="button" aria-label="Previous media">←</button>
        <div class="media-description"><strong id="media-caption"></strong><span id="media-provenance"></span><a id="media-source" data-original target="_blank" rel="noopener">Open original evidence</a></div>
        <button id="media-next" type="button" aria-label="Next media">→</button>
      </footer>
    </div>
  </dialog>
  <dialog id="work-file-dialog" class="file-dialog" aria-label="Evidence document">
    <div class="file-frame">
      <header class="file-bar"><strong id="file-name"></strong><button id="file-close" type="button">Close ×</button></header>
      <div class="file-tools"><span id="file-status" role="status"></span><a id="file-original" data-original target="_blank" rel="noopener">Download original file</a></div>
      <article id="file-markdown" class="work-markdown" hidden></article>
      <pre id="file-text" tabindex="0" hidden></pre>
    </div>
  </dialog>
  <script type="application/json" id="work-artifact-index" data-revision={work.sourceRevision} data-base={url("")} set:html={JSON.stringify(artifactIndex).replace(/</g, "\\u003c")} />
  {items.map((item) => <DetailTemplate id={`work-detail-${item.id}`}>
    <div class="detail-body" data-detail-id={item.id}>
      {item.media.length > 0 && <section class="detail-media" aria-label="Visual evidence">
        {item.media.map((media, index) => <figure>
          <button type="button" class="media-open" data-media-index={index} data-kind={media.kind} data-src={mediaSource(media.path)} data-caption={media.caption} data-provenance={media.provenance} data-evidence={evidenceLink(media.path)} aria-label={`Enlarge ${media.caption}`} aria-haspopup="dialog">
            {media.kind === "image"
              ? <img src={mediaSource(media.path)} alt={media.caption} loading="lazy" decoding="async" />
              : <><video src={mediaSource(media.path)} preload="none" muted playsinline aria-label={media.caption} /><span class="media-play">▶ Open video</span></>}
          </button>
          <figcaption><strong>{media.caption}</strong><span>{media.provenance}</span><a href={evidenceLink(media.path)}>Open evidence</a></figcaption>
        </figure>)}
      </section>}
      <header class="detail-summary"><p class="detail-kind">{item.archived ? "Archived change" : "Draft proposal"} · {names[item.lane].title}</p><h2>{item.title}</h2><p class="detail-revision">Snapshot {work.sourceRevision.slice(0, 12)} · {work.generated}</p><div class="detail-states"><span>{item.done}/{item.total} tasks</span><span>{sourceLabel[item.source]}</span><span>{physicalLabel[item.physical]}</span></div><p class="detail-gate"><strong>{item.archived ? "Closed record" : "Next gate"}</strong>{item.next}</p></header>
      {(item.dependencies.length > 0 || item.acceptedSpecs.length > 0 || item.evidence.length > 0 || item.rationale) && <aside class="detail-related"><strong>Related records</strong>{item.dependencies.map((id) => <a href={`${url("work/")}?work=${encodeURIComponent(id)}`}>Depends on: {byId[id]?.title ?? id}</a>)}{item.acceptedSpecs.map((path) => <a href={accepted(path)}>Accepted spec: {path.split("/").slice(2, 4).join(" / ")}</a>)}{item.evidence.map((path) => <a href={evidenceLink(path)}>{artifactName(path)}</a>)}{item.rationale && <p>Status basis: {item.rationale} <a href={`https://github.com/knewter/tdisplay-k230/commit/${item.reviewRevision}`}>Reviewed {item.reviewRevision?.slice(0, 12)} ↗</a></p>}</aside>}
      <nav class="detail-toc" aria-label={`Documents for ${item.title}`}><strong>In this change</strong>{item.rendered.map((doc, index) => <button type="button" data-work-section={index}>{doc.label}</button>)}</nav>
      <div class="detail-documents">{item.rendered.map((doc, index) => <section class="detail-document" data-section={index}><div class="detail-document-heading"><h3>{doc.label}</h3><span>{doc.path}</span></div><article class="work-markdown" set:html={doc.html} /></section>)}</div>
      <footer class="detail-sources"><strong>Source files at this revision</strong>{item.rendered.map((doc) => <a href={github(doc.path)}>{doc.label} ↗</a>)}</footer>
    </div>
  </DetailTemplate>)}
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#work-detail-dialog");
  const content = document.querySelector<HTMLElement>("#work-detail-content");
  const closeButton = document.querySelector<HTMLButtonElement>("#work-detail-close");
  let returnFocus: HTMLElement | null = null;
  let previousBodyOverflow = "";
  const mediaDialog = document.querySelector<HTMLDialogElement>("#work-media-dialog");
  const mediaImage = document.querySelector<HTMLImageElement>("#media-image");
  const mediaVideo = document.querySelector<HTMLVideoElement>("#media-video");
  const mediaClose = document.querySelector<HTMLButtonElement>("#media-close");
  const mediaPrevious = document.querySelector<HTMLButtonElement>("#media-previous");
  const mediaNext = document.querySelector<HTMLButtonElement>("#media-next");
  const mediaStage = document.querySelector<HTMLElement>("#media-stage");
  let mediaItems: HTMLButtonElement[] = [];
  let mediaIndex = 0;
  let mediaReturnFocus: HTMLElement | null = null;
  let cardScrollTop = 0;
  let mediaBodyOverflow = "";
  type Artifact = { path: string; href: string; raw: string; source: string };
  const artifactData = document.querySelector<HTMLElement>("#work-artifact-index");
  const artifacts: Artifact[] = (JSON.parse(artifactData?.textContent ?? "[]") as [string, string | null][]).map(([path, slug]) => {
    const encoded = path.split("/").map(encodeURIComponent).join("/");
    const raw = `https://raw.githubusercontent.com/knewter/tdisplay-k230/${artifactData?.dataset.revision}/${encoded}`;
    return { path, raw, href: slug ? `${artifactData?.dataset.base}evidence/${slug}/` : raw, source: `https://github.com/knewter/tdisplay-k230/blob/${artifactData?.dataset.revision}/${encoded}` };
  });
  const artifactByUrl = new Map<string, Artifact>();
  artifacts.forEach((artifact) => [artifact.href, artifact.raw, artifact.source].forEach((link) => artifactByUrl.set(new URL(link, location.href).href, artifact)));
  const fileDialog = document.querySelector<HTMLDialogElement>("#work-file-dialog");
  const fileText = document.querySelector<HTMLPreElement>("#file-text");
  const fileMarkdown = document.querySelector<HTMLElement>("#file-markdown");
  const fileClose = document.querySelector<HTMLButtonElement>("#file-close");
  let fileReturnFocus: HTMLElement | null = null;
  let fileBodyOverflow = "";
  let fileScrollTop = 0;
  let fileRequest: AbortController | null = null;

  function closeFile(): void {
    if (!fileDialog?.open) return;
    fileRequest?.abort();
    fileRequest = null;
    if (fileText) fileText.textContent = "";
    fileMarkdown?.replaceChildren();
    fileDialog.close();
    document.body.style.overflow = fileBodyOverflow;
    if (content) content.scrollTop = fileScrollTop;
    fileReturnFocus?.focus({ preventScroll: true });
  }

  async function openFile(artifact: Artifact, trigger: HTMLElement): Promise<void> {
    if (!fileDialog || !fileText) return;
    fileRequest?.abort();
    const request = new AbortController();
    fileRequest = request;
    fileReturnFocus = trigger;
    fileScrollTop = content?.scrollTop ?? 0;
    document.querySelector("#file-name")!.textContent = artifact.path;
    document.querySelector<HTMLAnchorElement>("#file-original")!.href = artifact.raw;
    const status = document.querySelector("#file-status")!;
    status.textContent = "Loading evidence…";
    fileText.hidden = true;
    fileText.textContent = "";
    if (fileMarkdown) { fileMarkdown.hidden = true; fileMarkdown.replaceChildren(); }
    if (!fileDialog.open) {
      fileBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      fileDialog.showModal();
    }
    fileClose?.focus();
    if (artifact.path.toLowerCase().endsWith(".md") && fileMarkdown) {
      const sections = [...(content?.querySelectorAll(".detail-document") ?? []), ...Array.from(document.querySelectorAll<HTMLTemplateElement>("template[id^='work-detail-']")).flatMap((template) => Array.from(template.content.querySelectorAll(".detail-document")))];
      const rendered = sections.find((section) => section.querySelector(".detail-document-heading span")?.textContent === artifact.path)?.querySelector(".work-markdown");
      if (rendered) {
        fileMarkdown.replaceChildren(...Array.from(rendered.childNodes).map((node) => node.cloneNode(true)));
        fileMarkdown.hidden = false;
        status.textContent = "Rendered Markdown";
        return;
      }
    }
    const report = new URL(artifact.href, location.href);
    const renderedReport = artifact.path.toLowerCase().endsWith(".md") && report.origin === location.origin;
    if (!/\.(md|txt|log|json|csv|toml|yaml|yml|py|sh|ini|diff|patch|nix|c|h|rs|html|xml|sha256)$/i.test(artifact.path)) {
      status.textContent = "This format has no document preview. Download the original file above.";
      return;
    }
    const timeout = setTimeout(() => request.abort(), 15000);
    try {
      const response = await fetch(renderedReport ? report.href : artifact.raw, { signal: request.signal });
      if (!response.ok || !response.body) throw new Error("Evidence could not be loaded.");
      const reader = response.body.getReader();
      const chunks: Uint8Array[] = [];
      let length = 0;
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        length += value.length;
        if (length > 2 * 1024 * 1024) { await reader.cancel(); throw new Error("This file exceeds the 2 MiB preview limit. Download the original above."); }
        chunks.push(value);
      }
      if (fileRequest !== request || request.signal.aborted) return;
      const bytes = new Uint8Array(length);
      let offset = 0;
      chunks.forEach((chunk) => { bytes.set(chunk, offset); offset += chunk.length; });
      const text = new TextDecoder().decode(bytes);
      if (renderedReport && fileMarkdown) {
        const rendered = new DOMParser().parseFromString(text, "text/html").querySelector(".ev-markdown");
        if (!rendered) throw new Error("This report has no rendered preview. Download the original above.");
        fileMarkdown.replaceChildren(...Array.from(rendered.childNodes).map((node) => document.importNode(node, true)));
        fileMarkdown.hidden = false;
        status.textContent = "Rendered Markdown";
      } else {
        fileText.textContent = text;
        fileText.hidden = false;
        status.textContent = `${length.toLocaleString()} bytes · Text preview`;
      }
    } catch (error) {
      if (fileRequest === request && fileDialog.open) status.textContent = request.signal.aborted ? "Preview timed out. Try again or download the original." : String(error instanceof Error ? error.message : error);
    } finally { clearTimeout(timeout); }
  }
  fileClose?.addEventListener("click", closeFile);
  fileDialog?.addEventListener("cancel", (event) => { event.preventDefault(); closeFile(); });
  document.addEventListener("click", (event) => {
    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[href]");
    if (!link || link.hasAttribute("data-original")) return;
    const artifact = artifactByUrl.get(link.href);
    if (!artifact) return;
    event.preventDefault();
    if (/\.(png|jpe?g|webp|gif|svg|mp4|webm|mov|m4v)$/i.test(artifact.path)) {
      const scope = link.closest(".detail-body") ?? (document.getElementById(`work-detail-${link.closest(".work-card")?.id}`) as HTMLTemplateElement | null)?.content;
      mediaItems = Array.from(scope?.querySelectorAll<HTMLButtonElement>(".media-open") ?? []);
      let index = mediaItems.findIndex((item) => new URL(item.dataset.evidence ?? "", location.href).href === link.href);
      if (index < 0) {
        const item = document.createElement("button");
        Object.assign(item.dataset, { src: artifact.raw, evidence: artifact.raw, caption: artifact.path.split("/").pop(), provenance: "Evidence — see record", kind: /\.(mp4|webm|mov|m4v)$/i.test(artifact.path) ? "video" : "image" });
        mediaItems = [item]; index = 0;
      }
      openMedia(index, link);
    } else { void openFile(artifact, link); }
  });

  function clearMedia(): void {
    mediaVideo?.pause();
    mediaVideo?.removeAttribute("src");
    mediaVideo?.load();
    mediaImage?.removeAttribute("src");
  }

  function displayMedia(index: number): void {
    if (!mediaImage || !mediaVideo || index < 0 || index >= mediaItems.length) return;
    clearMedia();
    mediaIndex = index;
    const item = mediaItems[index].dataset;
    const video = item.kind === "video";
    mediaImage.hidden = video;
    mediaVideo.hidden = !video;
    if (video) {
      mediaVideo.src = item.src ?? "";
      mediaVideo.setAttribute("aria-label", item.caption ?? "Video evidence");
      // Opening or navigating the viewer is the user's playback gesture.
      void mediaVideo.play().catch(() => { /* Native controls remain available if playback is blocked. */ });
    } else {
      mediaImage.src = item.src ?? "";
      mediaImage.alt = item.caption ?? "Image evidence";
    }
    document.querySelector("#media-caption")!.textContent = item.caption ?? "Evidence";
    document.querySelector("#media-provenance")!.textContent = item.provenance ?? "";
    document.querySelector("#media-position")!.textContent = `${index + 1} / ${mediaItems.length}`;
    document.querySelector<HTMLAnchorElement>("#media-source")!.href = item.evidence ?? "";
    if (mediaPrevious) mediaPrevious.disabled = index === 0;
    if (mediaNext) mediaNext.disabled = index === mediaItems.length - 1;
  }

  function closeMedia(): void {
    if (!mediaDialog?.open) return;
    clearMedia();
    mediaDialog.close();
    document.body.style.overflow = mediaBodyOverflow;
    if (content) content.scrollTop = cardScrollTop;
    mediaReturnFocus?.focus({ preventScroll: true });
    mediaItems = [];
  }

  function openMedia(index: number, trigger: HTMLElement): void {
    if (!mediaDialog) return;
    mediaReturnFocus = trigger;
    cardScrollTop = content?.scrollTop ?? 0;
    displayMedia(index);
    mediaBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    mediaDialog.showModal();
    mediaClose?.focus();
  }

  content?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>(".media-open");
    if (!button || !mediaDialog) return;
    mediaItems = Array.from(content.querySelectorAll<HTMLButtonElement>(".media-open"));
    openMedia(mediaItems.indexOf(button), button);
  });
  mediaClose?.addEventListener("click", closeMedia);
  mediaDialog?.addEventListener("cancel", (event) => { event.preventDefault(); closeMedia(); });
  mediaPrevious?.addEventListener("click", () => displayMedia(mediaIndex - 1));
  mediaNext?.addEventListener("click", () => displayMedia(mediaIndex + 1));
  mediaDialog?.addEventListener("keydown", (event) => {
    if ((event.key === " " || event.code === "Space") && mediaVideo && !mediaVideo.hidden) {
      event.preventDefault();
      event.stopPropagation();
      if (!event.repeat) {
        if (mediaVideo.paused) void mediaVideo.play().catch(() => {});
        else mediaVideo.pause();
      }
      return;
    }
    if (event.target === mediaVideo) return; // native player owns its seek keys
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      displayMedia(mediaIndex + (event.key === "ArrowRight" ? 1 : -1));
    }
  });
  let swipe: { id: number; x: number; y: number } | null = null;
  mediaStage?.addEventListener("pointerdown", (event) => {
    const playerControls = event.target === mediaVideo && mediaVideo && event.clientY > mediaVideo.getBoundingClientRect().bottom - 64;
    if (!event.isPrimary || playerControls) { swipe = null; return; }
    swipe = { id: event.pointerId, x: event.clientX, y: event.clientY };
    mediaStage.setPointerCapture(event.pointerId);
  });
  mediaStage?.addEventListener("pointercancel", () => { swipe = null; });
  mediaStage?.addEventListener("pointerup", (event) => {
    const start = swipe;
    swipe = null;
    if (!start || start.id !== event.pointerId) return;
    const dx = event.clientX - start.x, dy = event.clientY - start.y;
    if (Math.abs(dx) >= 60 && Math.abs(dx) > Math.abs(dy) * 1.5) displayMedia(mediaIndex + (dx < 0 ? 1 : -1));
  });

  function show(id: string, section = 0, push = true): void {
    const template = document.getElementById(`work-detail-${id}`) as HTMLTemplateElement | null;
    const trigger = document.querySelector<HTMLElement>(`[data-work-id="${CSS.escape(id)}"]`);
    if (!dialog || !content || !template || !trigger) return;
    returnFocus = trigger;
    const clone = template.content.firstElementChild?.cloneNode(true);
    if (!clone) return;
    closeMedia();
    closeFile();
    content.replaceChildren(clone);
    content.scrollTop = 0;
    if (!dialog.open) {
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      dialog.showModal();
    }
    closeButton?.focus();
    if (push) {
      const next = new URL(location.href);
      next.searchParams.set("work", id);
      if (section > 0) next.searchParams.set("doc", String(section));
      else next.searchParams.delete("doc");
      history.pushState({ workOpen: true }, "", next);
    }
    if (section > 0) requestAnimationFrame(() => content.querySelector<HTMLElement>(`[data-section="${section}"]`)?.scrollIntoView({ block: "start" }));
  }

  function hide(): void {
    if (!dialog?.open) return;
    closeMedia();
    closeFile();
    dialog.close();
    document.body.style.overflow = previousBodyOverflow;
    content?.replaceChildren();
    returnFocus?.focus({ preventScroll: true });
  }

  function requestClose(): void {
    if (history.state?.workOpen) {
      history.back();
    } else {
      const next = new URL(location.href);
      next.searchParams.delete("work");
      next.searchParams.delete("doc");
      history.replaceState({}, "", next);
      hide();
    }
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-work-id]").forEach((card) => {
    card.addEventListener("click", (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      show(card.dataset.workId ?? "", 0, true);
    });
  });
  closeButton?.addEventListener("click", requestClose);
  dialog?.addEventListener("cancel", (event) => { event.preventDefault(); requestClose(); });
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) requestClose(); });
  dialog?.addEventListener("click", (event) => {
    const jump = (event.target as Element).closest<HTMLButtonElement>("[data-work-section]");
    if (!jump) return;
    content?.querySelector<HTMLElement>(`[data-section="${jump.dataset.workSection}"]`)?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  window.addEventListener("popstate", () => {
    const selected = new URL(location.href).searchParams.get("work");
    if (selected && document.getElementById(`work-detail-${selected}`)) show(selected, Number(new URL(location.href).searchParams.get("doc") ?? 0), false);
    else hide();
  });
  const initial = new URL(location.href);
  const selected = initial.searchParams.get("work");
  if (selected && document.getElementById(`work-detail-${selected}`)) {
    const plain = new URL(initial);
    plain.searchParams.delete("work");
    plain.searchParams.delete("doc");
    history.replaceState({ workBoard: true }, "", plain);
    history.pushState({ workOpen: true }, "", initial);
    show(selected, Number(initial.searchParams.get("doc") ?? 0), false);
  }
</script>

