---
import Base from "../../layouts/Base.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import work from "../../data/work.json";
import { specs, url } from "../../lib/specs";
import { workMarkdownLinks } from "../../lib/work-markdown";

const names: Record<string, { title: string; hint: string }> = {
  planned: { title: "Planned", hint: "A committed proposal. Work and proof have not started in this snapshot." },
  "in-progress": { title: "In progress", hint: "Implementation or investigation is underway; acceptance remains open." },
  verification: { title: "Verification & review", hint: "Source or tasks advanced; the named review or evidence gate still matters." },
  archived: { title: "Archived", hint: "The OpenSpec change closed. This does not certify unrelated device features." },
};
const byId = Object.fromEntries(work.items.map((item) => [item.id, item]));
const sourceLabel: Record<string, string> = {
  "not-started": "Source: not started",
  "in-progress": "Source: in progress",
  "source-landed": "Source: landed checkpoint",
  archived: "Change: archived",
};
const physicalLabel: Record<string, string> = {
  "not-applicable": "Proof: see linked records",
  "not-recorded": "Device proof: see tasks",
  pending: "Device proof: pending",
  verified: "Device proof: verified for cited scope",
};
const github = (path: string) => `https://github.com/knewter/tdisplay-k230/blob/${work.sourceRevision}/${path}`;
const evidenceLink = (path: string) => {
  const local = specs.evidence.find((file) => file.path === path);
  return local ? url(`evidence/${local.slug}/`) : github(path);
};
const accepted = (path: string) => {
  const parts = path.split("/");
  return url(`c/${parts[2]}-${parts[3]}/`);
};
const documents = work.items.flatMap((item) => item.details.map((doc, section) => ({
  path: doc.path, workId: item.id, section,
})));
const items = await Promise.all(work.items.map(async (item) => ({
  ...item,
  rendered: await Promise.all(item.details.map(async (doc) => {
    const processor = await createMarkdownProcessor({
      syntaxHighlight: false,
      remarkRehype: { allowDangerousHtml: false },
      rehypePlugins: [workMarkdownLinks(doc.path, specs.evidence, documents, work.trackedPaths, import.meta.env.BASE_URL, work.sourceRevision)],
    });
    return { ...doc, html: (await processor.render(doc.markdown)).code };
  })),
})));
---

<Base title="Project work board · K230" source="work" description="A dated, evidence-aware snapshot of planned, active, verification and archived K230 work.">
  <main class="work-page">
    <nav class="work-breadcrumb" aria-label="Breadcrumb"><a href={url("")}>Verification ledger</a><span aria-hidden="true">/</span><span>Work board</span></nav>
    <header class="work-intro">
      <p class="work-kicker">K230 · public project snapshot</p>
      <h1>What remains, and what is proven.</h1>
      <p class="work-lede">Follow each change from proposal to evidence. The lanes reflect committed work at this revision, not a live agent feed. A checked task, landed source, archived plan, and verified device behavior are different claims.</p>
      <div class="work-meta"><span>As of <strong>{work.generated}</strong></span><span>Revision <a href={`https://github.com/knewter/tdisplay-k230/commit/${work.sourceRevision}`}><code>{work.sourceRevision.slice(0, 12)}</code></a></span><span>Source: {work.sourceMode}</span></div>
    </header>

    <nav class="work-jump" aria-label="Work lanes">
      {work.lanes.map((lane) => <a href={`#${lane.id}`}><span>{names[lane.id].title}</span><b>{lane.count}</b></a>)}
    </nav>

    <div class="work-grid">
      {work.lanes.map((lane) => <section class={`work-lane lane-${lane.id}`} id={lane.id} aria-labelledby={`${lane.id}-title`}>
        <div class="lane-head"><span class="lane-mark" aria-hidden="true"></span><div><h2 id={`${lane.id}-title`}>{names[lane.id].title}<span class="lane-count">{lane.count}</span></h2><p>{names[lane.id].hint}</p></div></div>
        <div class="lane-items">
          {items.filter((item) => item.lane === lane.id).map((item) => <article class="work-card" id={item.id} data-work-id={item.id}>
            <div class="card-top"><span class="card-kind">{item.archived ? "Archived change" : "Draft proposal"}</span><span class="card-count">{item.done}/{item.total} tasks</span></div>
            <h3>{item.title}</h3>
            <div class="card-progress" role="img" aria-label={`${item.done} of ${item.total} tasks checked`}><span style={`width:${item.total ? Math.round(100 * item.done / item.total) : 0}%`}></span></div>
            <div class="card-states"><span>{sourceLabel[item.source]}</span><span>{physicalLabel[item.physical]}</span></div>
            <div class="card-next"><strong>{item.archived ? "Closed record" : "Next gate"}</strong><p>{item.next}</p></div>
            <button class="card-open" type="button" data-open-work={item.id} aria-haspopup="dialog">View details <span aria-hidden="true">↗</span></button>
            {item.dependencies.length > 0 && <p class="card-deps"><strong>Depends on</strong>{item.dependencies.map((id) => <a href={`#${id}`}>{byId[id]?.title ?? id}</a>)}</p>}
            <div class="card-links"><button type="button" data-open-work={item.id} data-open-section="0">Proposal</button><button type="button" data-open-work={item.id} data-open-section="2">Tasks</button>{item.acceptedSpecs.map((path) => <a href={accepted(path)}>Spec: {path.split("/").slice(2, 4).join(" / ")}</a>)}{item.evidence.map((path) => <a href={evidenceLink(path)}>{specs.evidence.some((file) => file.path === path) ? "Evidence" : "Evidence source ↗"}</a>)}</div>
            {item.rationale && <details class="card-basis"><summary>Status basis</summary><p>{item.rationale}</p><p>Reviewed from <a href={`https://github.com/knewter/tdisplay-k230/commit/${item.reviewRevision}`}><code>{item.reviewRevision?.slice(0, 12)}</code></a>.</p></details>}
          </article>)}
        </div>
      </section>)}
    </div>
    <aside class="work-notes"><h2>How to read this board</h2><p>Task counts come from committed OpenSpec checkboxes. Reviewed status notes distinguish landed source from physical proof where the checklist alone cannot. “Archived” describes a closed change and its cited scope; it is not a claim that every related feature ships in the current image. Open proposals are drafts and never enter the <a href={url("")}>accepted requirement count</a>.</p></aside>
  </main>
  <dialog id="work-detail-dialog" class="work-dialog" aria-label="Work item details">
    <div class="dialog-frame"><header class="dialog-bar"><span>Project work · committed detail</span><button id="work-detail-close" type="button">Close <span aria-hidden="true">×</span></button></header><div id="work-detail-content" class="dialog-scroll"></div></div>
  </dialog>
  {items.map((item) => <div class="detail-template" hidden id={`work-detail-${item.id}`}>
    <div class="detail-body" data-detail-id={item.id}>
      <header class="detail-summary"><p class="detail-kind">{item.archived ? "Archived change" : "Draft proposal"} · {names[item.lane].title}</p><h2>{item.title}</h2><p class="detail-revision">Snapshot {work.sourceRevision.slice(0, 12)} · {work.generated}</p><div class="detail-states"><span>{item.done}/{item.total} tasks</span><span>{sourceLabel[item.source]}</span><span>{physicalLabel[item.physical]}</span></div><p class="detail-gate"><strong>{item.archived ? "Closed record" : "Next gate"}</strong>{item.next}</p></header>
      <nav class="detail-toc" aria-label={`Documents for ${item.title}`}><strong>In this change</strong>{item.rendered.map((doc, index) => <button type="button" data-work-section={index}>{doc.label}</button>)}</nav>
      <div class="detail-documents">{item.rendered.map((doc, index) => <section class="detail-document" data-section={index}><div class="detail-document-heading"><h3>{doc.label}</h3><span>{doc.path}</span></div><article class="work-markdown" set:html={doc.html} /></section>)}</div>
      <footer class="detail-sources"><strong>Source files at this revision</strong>{item.rendered.map((doc) => <a href={github(doc.path)}>{doc.label} ↗</a>)}</footer>
    </div>
  </div>)}
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#work-detail-dialog");
  const content = document.querySelector<HTMLElement>("#work-detail-content");
  const closeButton = document.querySelector<HTMLButtonElement>("#work-detail-close");
  let returnFocus: HTMLElement | null = null;
  let previousBodyOverflow = "";

  function show(id: string, section = 0, push = true): void {
    const template = document.getElementById(`work-detail-${id}`);
    const trigger = document.querySelector<HTMLElement>(`[data-open-work="${CSS.escape(id)}"]`);
    if (!dialog || !content || !template || !trigger) return;
    returnFocus = trigger;
    const clone = template.firstElementChild?.cloneNode(true);
    if (!clone) return;
    content.replaceChildren(clone);
    content.scrollTop = 0;
    if (!dialog.open) {
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      dialog.showModal();
    }
    closeButton?.focus();
    if (push) {
      const next = new URL(location.href);
      next.searchParams.set("work", id);
      if (section > 0) next.searchParams.set("doc", String(section));
      else next.searchParams.delete("doc");
      history.pushState({ workOpen: true }, "", next);
    }
    if (section > 0) requestAnimationFrame(() => content.querySelector<HTMLElement>(`[data-section="${section}"]`)?.scrollIntoView({ block: "start" }));
  }

  function hide(): void {
    if (!dialog?.open) return;
    dialog.close();
    document.body.style.overflow = previousBodyOverflow;
    content?.replaceChildren();
    returnFocus?.focus({ preventScroll: true });
  }

  function requestClose(): void {
    if (history.state?.workOpen) {
      history.back();
    } else {
      const next = new URL(location.href);
      next.searchParams.delete("work");
      next.searchParams.delete("doc");
      history.replaceState({}, "", next);
      hide();
    }
  }

  document.querySelectorAll<HTMLElement>("[data-work-id]").forEach((card) => {
    card.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a, button, summary, details")) return;
      show(card.dataset.workId ?? "", 0, true);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-open-work]").forEach((button) => {
    button.addEventListener("click", () => show(button.dataset.openWork ?? "", Number(button.dataset.openSection ?? 0), true));
  });
  closeButton?.addEventListener("click", requestClose);
  dialog?.addEventListener("cancel", (event) => { event.preventDefault(); requestClose(); });
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) requestClose(); });
  dialog?.addEventListener("click", (event) => {
    const jump = (event.target as Element).closest<HTMLButtonElement>("[data-work-section]");
    if (!jump) return;
    content?.querySelector<HTMLElement>(`[data-section="${jump.dataset.workSection}"]`)?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  window.addEventListener("popstate", () => {
    const selected = new URL(location.href).searchParams.get("work");
    if (selected && document.getElementById(`work-detail-${selected}`)) show(selected, Number(new URL(location.href).searchParams.get("doc") ?? 0), false);
    else hide();
  });
  const initial = new URL(location.href);
  const selected = initial.searchParams.get("work");
  if (selected && document.getElementById(`work-detail-${selected}`)) {
    const plain = new URL(initial);
    plain.searchParams.delete("work");
    plain.searchParams.delete("doc");
    history.replaceState({ workBoard: true }, "", plain);
    history.pushState({ workOpen: true }, "", initial);
    show(selected, Number(initial.searchParams.get("doc") ?? 0), false);
  }
</script>

<style>
  :global(body:has(.work-page)) { padding-inline: clamp(16px, 3vw, 40px); }
  .work-page { max-width: 1540px; margin: 0 auto 5rem; }
  .work-breadcrumb, .work-kicker, .work-meta, .work-jump, .lane-head, .card-top, .card-states, .card-next strong, .card-deps strong, .card-links, .card-basis { font-family: var(--mono); }
  .work-breadcrumb { display:flex; gap:.7rem; font-size:.77rem; color:var(--muted); margin-bottom:clamp(1.5rem,3vw,2.5rem); }
  .work-intro { max-width:1100px; }
  .work-kicker { color:var(--accent); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:600; }
  h1 { font-family:var(--sans); font-size:clamp(2.35rem,4vw,4rem); line-height:1.04; letter-spacing:-.035em; margin:.5rem 0 .9rem; max-width:1100px; }
  .work-lede { font-size:clamp(1rem,1.2vw,1.16rem); color:var(--ink-2); line-height:1.48; max-width:960px; }
  .work-meta { display:flex; flex-wrap:wrap; gap:.4rem 1.4rem; color:var(--muted); font-size:.7rem; margin:1.3rem 0 1.9rem; }
  .work-meta strong { color:var(--ink); }
  .work-jump { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; background:var(--rule); border:1px solid var(--rule); border-radius:8px; overflow:hidden; margin:0 0 1.5rem; }
  .work-jump a { display:flex; justify-content:space-between; align-items:center; gap:.5rem; min-height:52px; padding:.7rem .9rem; background:var(--surface); text-decoration:none; font-size:.73rem; color:var(--ink-2); }
  .work-jump a:hover,.work-jump a:focus-visible { background:var(--surface-2); color:var(--accent); }
  .work-jump b,.lane-count { font-variant-numeric:tabular-nums; font-size:.7rem; color:var(--accent); }
  .work-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; align-items:start; }
  .work-lane { min-width:0; scroll-margin-top:1rem; }
  .lane-head { min-height:114px; display:flex; align-items:flex-start; gap:.7rem; border-top:3px solid var(--accent); padding:1rem .15rem .7rem; }
  .lane-mark { display:block; width:8px; height:8px; margin-top:.56rem; background:var(--accent); border-radius:50%; flex:none; }
  .lane-head h2 { display:flex; align-items:center; gap:.5rem; font-size:.82rem; line-height:1.3; margin:0; color:var(--ink); }
  .lane-head p { color:var(--muted); font-size:.66rem; line-height:1.45; margin:.45rem 0 0; }
  .lane-in-progress .lane-head { border-color:var(--unverified); } .lane-in-progress .lane-mark { background:var(--unverified); }
  .lane-verification .lane-head { border-color:var(--soc); } .lane-verification .lane-mark { background:var(--soc); }
  .lane-archived .lane-head { border-color:var(--grounded); } .lane-archived .lane-mark { background:var(--grounded); }
  .lane-items { display:grid; gap:.75rem; }
  .work-card { min-width:0; padding:1rem; border:1px solid var(--rule); border-radius:8px; background:var(--surface); box-shadow:var(--shadow); overflow-wrap:anywhere; }
  .card-top { display:flex; justify-content:space-between; gap:.4rem; color:var(--muted); font-size:.63rem; line-height:1.3; }
  .card-kind { text-transform:uppercase; letter-spacing:.07em; }
  .card-count { white-space:nowrap; font-variant-numeric:tabular-nums; }
  .work-card h3 { font-family:var(--sans); font-size:1.15rem; line-height:1.18; letter-spacing:-.01em; margin:.7rem 0 .9rem; }
  .card-progress { height:4px; background:var(--rule-2); border-radius:10px; overflow:hidden; }
  .card-progress span { display:block; height:100%; background:var(--accent); }
  .card-states { display:flex; flex-wrap:wrap; gap:.3rem; margin:.8rem 0 1rem; }
  .card-states span { padding:.2rem .35rem; border:1px solid var(--rule); border-radius:3px; font-size:.59rem; line-height:1.35; color:var(--ink-2); }
  .card-next { padding:.65rem .7rem; background:var(--surface-2); border-left:2px solid var(--accent); }
  .card-next strong,.card-deps strong { display:block; color:var(--accent); font-size:.61rem; text-transform:uppercase; letter-spacing:.08em; }
  .card-next p { font-family:var(--sans); font-size:.86rem; line-height:1.43; margin:.38rem 0 0; }
  .card-open { width:100%; display:flex; justify-content:space-between; align-items:center; gap:.7rem; min-height:44px; margin:.8rem 0 0; padding:.55rem .7rem; background:var(--accent); border:1px solid var(--accent); border-radius:4px; color:var(--surface); font:600 .78rem var(--mono); cursor:pointer; text-align:left; }
  .card-open:hover,.card-open:focus-visible { filter:brightness(1.12); outline:2px solid var(--accent); outline-offset:2px; }
  .card-open span { font-size:1.15rem; line-height:1; }
  .card-deps { display:flex; flex-direction:column; gap:.22rem; font-size:.7rem; margin:.9rem 0 0; }
  .card-links { display:flex; flex-wrap:wrap; gap:.35rem .7rem; border-top:1px solid var(--rule-2); padding-top:.75rem; margin-top:.85rem; font-size:.66rem; }
  .card-links a,.card-links button { min-height:30px; display:inline-flex; align-items:center; font:inherit; color:var(--accent); text-decoration:underline; }
  .card-links button { padding:0; border:0; background:none; cursor:pointer; }
  .card-links button:hover,.card-links button:focus-visible { color:var(--ink); outline:2px solid var(--accent); outline-offset:2px; }
  .card-basis { border-top:1px solid var(--rule-2); font-size:.65rem; color:var(--muted); padding-top:.5rem; }
  .card-basis summary { cursor:pointer; color:var(--ink-2); }
  .card-basis p { margin:.4rem 0; }
  .work-notes { max-width:830px; border-top:1px solid var(--rule); margin:3rem 0 0; padding-top:1rem; }
  .work-notes h2 { font-family:var(--sans); font-size:1.2rem; }
  .work-notes p { color:var(--ink-2); font-size:.94rem; }
  .work-dialog { width:min(1050px,calc(100vw - 32px)); height:min(94dvh,1100px); max-width:none; max-height:none; margin:auto; padding:0; border:1px solid var(--rule); border-radius:12px; background:var(--surface); color:var(--ink); box-shadow:0 24px 90px #0008; }
  .work-dialog::backdrop { background:#050a0bba; backdrop-filter:blur(3px); }
  .dialog-frame { display:flex; flex-direction:column; height:100%; min-height:0; }
  .dialog-bar { display:flex; justify-content:space-between; align-items:center; flex:none; min-height:56px; gap:1rem; padding:.55rem 1.1rem; border-bottom:1px solid var(--rule); background:var(--surface); color:var(--ink-2); font:600 .7rem var(--mono); text-transform:uppercase; letter-spacing:.05em; }
  .dialog-bar button { min-width:82px; min-height:40px; padding:.4rem .7rem; background:var(--surface-2); color:var(--ink); border:1px solid var(--rule); border-radius:4px; font:600 .72rem var(--mono); cursor:pointer; }
  .dialog-bar button span { font-size:1.1rem; margin-left:.2rem; }
  .dialog-bar button:hover,.dialog-bar button:focus-visible { border-color:var(--accent); outline:2px solid var(--accent); outline-offset:2px; }
  .dialog-scroll { flex:1; min-height:0; overflow-y:auto; overscroll-behavior:contain; scroll-behavior:smooth; }
  .detail-body { max-width:880px; margin:0 auto; padding:clamp(1rem,3vw,2.4rem); }
  .detail-summary { padding-bottom:1.2rem; border-bottom:1px solid var(--rule); }
  .detail-kind,.detail-revision,.detail-states,.detail-gate strong,.detail-toc,.detail-document-heading,.detail-sources { font-family:var(--mono); }
  .detail-kind { margin:0 0 .5rem; font-size:.69rem; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); }
  .detail-summary h2 { font-family:var(--sans); font-size:clamp(1.7rem,3.5vw,2.8rem); line-height:1.08; margin:0 0 .65rem; }
  .detail-revision { color:var(--muted); font-size:.68rem; margin:0 0 1.1rem; }
  .detail-states { display:flex; flex-wrap:wrap; gap:.4rem; }
  .detail-states span { padding:.25rem .45rem; border:1px solid var(--rule); border-radius:3px; font-size:.64rem; }
  .detail-gate { display:grid; gap:.35rem; margin:1.1rem 0 0; padding:.8rem 1rem; background:var(--surface-2); border-left:3px solid var(--accent); font-family:var(--sans); font-size:.97rem; }
  .detail-gate strong { color:var(--accent); font-size:.66rem; text-transform:uppercase; letter-spacing:.08em; }
  .detail-toc { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem; margin:1.2rem 0 2.2rem; font-size:.7rem; }
  .detail-toc strong { margin-right:.4rem; color:var(--muted); }
  .detail-toc button { min-height:36px; padding:.35rem .55rem; border:1px solid var(--rule); border-radius:4px; background:var(--surface-2); color:var(--ink); font:inherit; cursor:pointer; }
  .detail-toc button:hover,.detail-toc button:focus-visible { border-color:var(--accent); color:var(--accent); }
  .detail-document { scroll-margin-top:1rem; margin:0 0 2.8rem; }
  .detail-document-heading { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:.3rem 1rem; border-bottom:2px solid var(--accent); padding:0 0 .45rem; }
  .detail-document-heading h3 { font-size:.83rem; margin:0; text-transform:uppercase; letter-spacing:.08em; }
  .detail-document-heading span { color:var(--muted); font-size:.59rem; overflow-wrap:anywhere; }
  .detail-sources { display:flex; flex-wrap:wrap; gap:.4rem 1rem; border-top:1px solid var(--rule); padding-top:1rem; color:var(--muted); font-size:.67rem; }
  .detail-sources strong { flex-basis:100%; color:var(--ink-2); }
  :global(.work-markdown) { overflow-wrap:anywhere; font-size:.94rem; line-height:1.65; }
  :global(.work-markdown h1), :global(.work-markdown h2), :global(.work-markdown h3), :global(.work-markdown h4) { font-family:var(--sans); line-height:1.18; margin:1.4em 0 .5em; }
  :global(.work-markdown h1) { font-size:1.65rem; } :global(.work-markdown h2) { font-size:1.3rem; } :global(.work-markdown h3) { font-size:1.08rem; }
  :global(.work-markdown p), :global(.work-markdown ul), :global(.work-markdown ol) { margin:.65rem 0 1rem; }
  :global(.work-markdown li) { margin:.3rem 0; }
  :global(.work-markdown pre) { overflow-x:auto; max-width:100%; padding:.85rem; border:1px solid var(--rule); border-radius:5px; background:var(--surface-2); font: .77rem/1.5 var(--mono); }
  :global(.work-markdown pre code) { border:0; background:none; padding:0; word-break:normal; white-space:pre; }
  :global(.work-markdown table) { display:block; overflow-x:auto; border-collapse:collapse; max-width:100%; margin:1rem 0; font-size:.78rem; }
  :global(.work-markdown th), :global(.work-markdown td) { border:1px solid var(--rule); padding:.4rem .55rem; min-width:5rem; }
  :global(.work-markdown th) { background:var(--surface-2); font-family:var(--sans); text-align:left; }
  :global(.work-markdown blockquote) { border-left:3px solid var(--accent); margin:1rem 0; padding:.1rem 1rem; color:var(--ink-2); }
  @media (max-width:1100px) { .work-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .lane-head { min-height:95px; } }
  @media (max-width:650px) { .work-grid { grid-template-columns:minmax(0,1fr); } .work-jump { grid-template-columns:repeat(2,minmax(0,1fr)); } .lane-head { min-height:0; margin-top:.65rem; } .lane-items { grid-template-columns:minmax(0,1fr); } .work-card { padding:1rem 1.1rem; } .work-dialog { width:100vw; height:100dvh; margin:0; border:0; border-radius:0; } .dialog-bar { padding:.5rem .9rem; } .detail-body { padding:1rem; } .detail-document-heading span { flex-basis:100%; } }
</style>
