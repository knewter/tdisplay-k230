---
import { Image } from "astro:assets";
import HardwareNote from "../../layouts/HardwareNote.astro";
import HwSection from "../../components/HwSection.astro";
import HwFigure from "../../components/HwFigure.astro";
import HwNote from "../../components/HwNote.astro";
import board from "../../assets/t-display-k230-board.png";

// The U-Boot pinmux, quoted rather than paraphrased. <u> is a SEL value,
// <i> a comment carried over from the vendor file, <em> a comment that is
// wrong about this board.
const pinmux = `u-boot/arch/riscv/dts/<b>k230_canmv_v3p0.dts</b>

&amp;iomux {
    pinctrl-names = "default";
    pinctrl-0 = &lt;&amp;pins&gt;;
    pins: iomux_pins {
        pinctrl-single,pins = &lt;
          <i>// lcd_rst</i>
          (IO22) ( <u>0</u>&lt;&lt;SEL | … | 1&lt;&lt;IE | 1&lt;&lt;OE | 15&lt;&lt;DS | 1&lt;&lt;ST )
          <i>// hdmi_int,gpio</i>      <em>← on this board it is the touch INT</em>
          (IO23) ( <u>0</u>&lt;&lt;SEL | … )
          <i>// hdmi_rset ,gpio</i>    <em>← on this board it is the touch reset</em>
          (IO24) ( <u>0</u>&lt;&lt;SEL | … )
          <i>// LCD_EN</i>
          (IO25) ( <u>0</u>&lt;&lt;SEL | … | 7&lt;&lt;DS | 1&lt;&lt;ST )
          <i>// i2c3</i>
          (IO36) ( <u>1</u>&lt;&lt;SEL | … )    <i>→ IIC3_SCL</i>
          <i>// BT_UART_TXD</i>         <em>← also wrong; SEL=1 on IO37 is IIC3_SDA</em>
          (IO37) ( <u>1</u>&lt;&lt;SEL | … )
          (IO45) ( <u>0</u>&lt;&lt;SEL | … )    <i>→ plain GPIO; the schematic calls it IO45_WIFI_EN</i>
          <i>// MMC1 -&gt; TFCARD</i>
          (IO54) ( <u>2</u>&lt;&lt;SEL | … )    <i>→ MMC1_CMD</i>
        &gt;;
    };
};`;
---

<HardwareNote
  slug="silicon-map"
  title="What the device tree actually turns on"
  eyebrow="LILYGO T-Display-K230 · hardware note"
  dek="Every subsystem on this board, traced to the exact device-tree node that enables it &mdash; and marked where the upstream CanMV&nbsp;v3 reference describes a board that is not ours."
  description="Every subsystem on the LILYGO T-Display-K230, traced to the device-tree node that enables it, and where the CanMV v3 reference describes a different board."
  source="nix/dts/k230-tdisplay.dts"
  meta={[
    { label: "SoC file", value: "canaan/k230.dtsi<br>857 lines, 56 nodes" },
    { label: "Reference board", value: "canaan/k230-canmv-v3-lcd.dts<br>96 lines" },
    { label: "Our board file", value: "nix/dts/k230-tdisplay.dts<br>compiles to 55,156 bytes" },
    { label: "Kernel", value: "ruyisdk/linux-xuantie-kernel<br>pinned 7d4e1f4" },
    { label: "Observed so far", value: "U-Boot, on hardware<br>Linux has not booted" },
  ]}
>
  <HwSection kind="the board" title="Four things a product render can prove">
    <p class="hw-lede">
      A 4.1&Prime; AMOLED slab on a K230D. The picture below is LilyGO&rsquo;s own
      product shot and the markers are placed by eye. The authoritative map is the
      fan-out that follows: the device tree cares which pad a thing hangs off, not
      where it sits on the board.
    </p>

    <HwFigure
      bare
      caption="<strong>Only four markers, because only four things are identifiable in a render.</strong> The connectors along the bottom edge &mdash; USB-C, HDMI and the card slot are all present per LilyGO&rsquo;s pin table &mdash; have not been told apart here, and guessing at them would be the wrong kind of confident. Component identities come from the schematic and the vendor BSP; positions are eyeballed."
    >
      <div class="hw-photo">
        <Image
          src={board}
          alt="Two views of the LILYGO T-Display-K230: the AMOLED front, and the component side."
          widths={[400, 548]}
          sizes="(max-width: 700px) 100vw, 920px"
          loading="eager"
        />
        <span class="hw-pin hw-pin-l" style="left:23%; top:36%">
          <i></i><span>RM69A10 568&times;1232 AMOLED</span>
        </span>
        <span class="hw-pin" style="left:75.5%; top:33.5%">
          <i></i><span>camera &middot; MIPI CSI</span>
        </span>
        <span class="hw-pin" style="left:85%; top:41%"><i></i><span>RF module</span></span>
        <span class="hw-pin hw-pin-l" style="left:56.5%; top:55%">
          <i></i><span>K230D, approximately</span>
        </span>
      </div>
    </HwFigure>
  </HwSection>

