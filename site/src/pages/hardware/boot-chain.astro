        <rect x="40" y="362" width="320" height="44" rx="3" fill="var(--surface)" stroke="var(--rule)" stroke-width="1.3"></rect>
        <text x="200" y="381" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--ink-2)" font-family="var(--mono)">kernel boots · no init= present</text>
        <text x="200" y="398" text-anchor="middle" font-size="10" fill="var(--muted)" font-family="var(--mono)">root mounts anyway — see the coincidence</text>

        <line x1="200" y1="406" x2="200" y2="432" stroke="var(--undeclared)" stroke-width="1.6" marker-end="url(#bc-bad)"></line>

        <rect x="40" y="434" width="320" height="44" rx="3" fill="var(--surface)" stroke="var(--undeclared)" stroke-width="1.3"></rect>
        <text x="200" y="453" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--undeclared)" font-family="var(--mono)">initrd-find-nixos-closure: exit 1</text>
