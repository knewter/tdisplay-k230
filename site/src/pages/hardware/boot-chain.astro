        <rect x="316" y="174" width="288" height="46" rx="23" fill="var(--surface-2)" stroke="var(--ink-2)" stroke-width="1.6"></rect>
        <text x="460" y="203" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)" font-family="var(--mono)">env_get("bootargs") == NULL ?</text>

