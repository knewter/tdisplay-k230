        <text x="662" y="189" text-anchor="middle" font-size="11" font-weight="700" fill="var(--grounded)" font-family="var(--mono)">no</text>
        <text x="662" y="230" text-anchor="middle" font-size="10" fill="var(--muted)" font-family="var(--mono)">after the env fix</text>

        {/* failing column */}
        <rect x="40" y="248" width="320" height="86" rx="3" fill="var(--undeclared-f)" stroke="var(--undeclared)" stroke-width="1.4"></rect>
        <text x="56" y="270" font-size="11.5" font-weight="700" fill="var(--undeclared)" font-family="var(--sans)">HARDCODED VENDOR STRING</text>
        <text x="56" y="289" font-size="10" fill="var(--ink-2)" font-family="var(--mono)">root=/dev/mmcblk1p2 loglevel=8 rw</text>
        <text x="56" y="304" font-size="10" fill="var(--ink-2)" font-family="var(--mono)">rootdelay=4 rootfstype=ext4</text>
        <text x="56" y="319" font-size="10" fill="var(--ink-2)" font-family="var(--mono)">console=ttyS0,115200  earlycon=sbi</text>

        <line x1="200" y1="334" x2="200" y2="360" stroke="var(--undeclared)" stroke-width="1.6" marker-end="url(#bc-bad)"></line>
