---
import HardwareNote from "../../layouts/HardwareNote.astro";
import HwSection from "../../components/HwSection.astro";
import HwFigure from "../../components/HwFigure.astro";
import HwNote from "../../components/HwNote.astro";

// Code samples live here rather than in the template so that DTS braces do
// not have to fight Astro's expression syntax. <b> is ours, <u> comes from
// the SoC file, <i> is a comment, <em> is something deliberately not written.
const kind1 = `&amp;uart0 {
    <b>status = "okay";</b>
};`;

const kind2 = `&amp;mmc_sd0 {
    <b>status = "okay";</b>
    <b>no-1-8-v;</b>
    <b>rx_delay_line = &lt;0x0d&gt;;</b>
    <b>tx_delay_line = &lt;0xc0&gt;;</b>
};`;

const kind3 = `&amp;i2c3 {
    <b>status = "okay";</b>
    <b>touchscreen@5d {</b>
        <b>compatible = "goodix,gt9895";</b>
        <b>reg = &lt;0x5d&gt;;</b>
        <b>reset-gpios = &lt;&amp;gpio0_ports 24 GPIO_ACTIVE_LOW&gt;;</b>
        <b>interrupt-parent = &lt;&amp;gpio0_ports&gt;;</b>
        <b>interrupts = &lt;23 IRQ_TYPE_EDGE_FALLING&gt;;</b>
    <b>};</b>
};`;

const kind4 = `&amp;mipi0 {
    <i>// set to csi2</i>
    <b>id = &lt;2&gt;;</b>
    <b>reg = &lt;0x0 0x9000a800 0x0 0x800&gt;;</b>
    <b>interrupts = &lt;121 IRQ_TYPE_LEVEL_HIGH&gt;;</b>
    <b>resets = &lt;&amp;sysctl_reset K230_RESET_CSI2_…&gt;,</b>
             <b>&lt;&amp;sysctl_reset K230_RESET_M2_…&gt;;</b>
};`;

const kind5 = `&amp;dsi {
    ports {
        <b>port@1 {</b>
            <b>reg = &lt;1&gt;;</b>
            <b>dsi_out_rm69a10: endpoint {</b>
                <b>remote-endpoint = &lt;&amp;rm69a10_in&gt;;</b>
            <b>};</b>
        <b>};</b>
    };
};`;

const kind6 = `/ {
    <b>model = "LILYGO T-Display-K230";</b>
    <b>compatible = "lilygo,t-display-k230",</b>
                 <b>"canaan,canmv-k230",</b>
                 <b>"canaan,kendryte-k230";</b>
    <b>aliases { serial3 = &amp;uart3; mmc0 = &amp;mmc_sd0;</b>
              <b>mmc1 = &amp;mmc_sd1; i2c0 = &amp;i2c4; i2c1 = &amp;i2c3; };</b>
    <b>chosen { stdout-path = "serial0:115200n8"; };</b>
    <b>ddr: memory@0 {</b>
        <b>device_type = "memory";</b>
        <b>reg = &lt;0x0 0x0 0x0 0x40000000&gt;;   </b><i>// 1 GiB</i>
    <b>};</b>
    <b>sound { compatible = "canaan,k230-audio-inno"; … };</b>
};`;

const kind7 = `#include "k230.dtsi"
<b>#include "display-rm69a10-568x1232.dtsi"</b>

<i>// …and later, supply the pins the fragment</i>
<i>// declared but deliberately left off the panel node:</i>
&amp;lcd {
    <b>dsi_reset-gpios      = &lt;&amp;gpio0_ports 22 GPIO_ACTIVE_HIGH&gt;;</b>
    <b>backlight_gpio-gpios = &lt;&amp;gpio0_ports 25 GPIO_ACTIVE_HIGH&gt;;</b>
};`;

// The committed board file, abridged only by eliding the reference's own
// &mipi0 override and the sound node's inner properties.
const boardFile = `<i>// nix/dts/k230-tdisplay.dts — compiles, and booted Linux on</i>
<i>// 2026-09-20. The panel it describes has still never lit.</i>

/dts-v1/;

#include "k230.dtsi"
<b>#include "display-rm69a10-568x1232.dtsi"</b>          <i>// ours</i>

/ {
    <b>model = "LILYGO T-Display-K230";</b>
    <b>compatible = "lilygo,t-display-k230", "canaan,canmv-k230",
                 "canaan,kendryte-k230";</b>

    aliases {
        serial3 = &amp;uart3;
        mmc0 = &amp;mmc_sd0;   <i>// the RTL8189FTV, over SDIO</i>
        mmc1 = &amp;mmc_sd1;   <i>// the TF card, and the boot device</i>
        i2c0 = &amp;i2c4; i2c1 = &amp;i2c3;
    };

    chosen { stdout-path = "serial0:115200n8"; };   <i>// ttyS0, not ttyS1</i>
    ddr: memory@0 { device_type = "memory"; reg = &lt;0x0 0x0 0x0 0x40000000&gt;; };
    sound { compatible = "canaan,k230-audio-inno"; … };
};

&amp;uart0 { status = "okay"; };                        <i>// CH342 ch0 — console</i>
&amp;uart3 { status = "okay"; };                        <i>// CH342 ch1</i>
&amp;usb0  { status = "okay"; };
&amp;usb1  { status = "okay"; };

&amp;mmc_sd1 { status = "okay"; no-1-8-v; cap-sd-highspeed; mshc_ctrl_r = &lt;0x00&gt;; };

&amp;mmc_sd0 {                                          <i>// carried over verbatim</i>
    status = "okay"; no-1-8-v;
    rx_delay_line = &lt;0x0d&gt;; tx_delay_line = &lt;0xc0&gt;;
};
<em>// NOT WRITTEN — no mmc-pwrseq and no regulator, so nothing asserts IO45
//   and the radio stays unpowered under Linux exactly as it does under
//   RT-Smart. A known gap, left visible rather than guessed at.</em>

&amp;i2c3 {
    status = "okay";
    <b>touchscreen@5d {</b>                              <i>// the reference has ft5306@38</i>
        <b>compatible = "goodix,gt9895";</b>              <i>// no driver matches this, anywhere</i>
        <b>reg = &lt;0x5d&gt;;</b>
        reset-gpios = &lt;&amp;gpio0_ports 24 GPIO_ACTIVE_LOW&gt;;
        interrupt-parent = &lt;&amp;gpio0_ports&gt;;
        interrupts = &lt;23 IRQ_TYPE_EDGE_FALLING&gt;;
    <b>};</b>
};
&amp;i2c4 { status = "okay"; };

&amp;mipi0 { <i>/* re-pointed to CSI-2, exactly as the reference does */</i> };

<em>// NOT WRITTEN — no LT9611 node. The non-LCD reference gives it
//   gpio0_ports 24 and 23, which on this board are the touch controller's.
// NOT WRITTEN — BQ25896, BQ27220, SX1262/LR2021: bus and chip-select unread.</em>

&amp;lcd {                                              <i>// the label on our panel node</i>
    dsi_reset-gpios      = &lt;&amp;gpio0_ports 22 GPIO_ACTIVE_HIGH&gt;;
    backlight_gpio-gpios = &lt;&amp;gpio0_ports 25 GPIO_ACTIVE_HIGH&gt;;
};`;
---

<HardwareNote
  slug="overlay-anatomy"
  title="One SoC file, one board file, and what happens where they meet"
  eyebrow="Kendryte K230 · hardware note"
  dek="<code>k230.dtsi</code> describes the silicon and switches almost all of it off. A board <code>.dts</code> reaches back into it by label and turns things on. That seam is the whole of a board port, so it is worth knowing exactly what it lets you do."
  description="How k230.dtsi and a board .dts compose: the include graph, a census of the SoC file by status, how an ampersand-label override resolves, and the seven kinds of edit a board file can make."
  source="nix/dts/k230-tdisplay.dts"
  meta={[
    { label: "SoC file", value: "k230.dtsi<br>857 lines · 56 nodes" },
    { label: "Clock tree", value: "k230_clock_provider.dtsi<br>3,354 lines · 150 nodes" },
    { label: "Our board file", value: "k230-tdisplay.dts<br>129 lines" },
    { label: "Flattened", value: "234 nodes<br>184 okay · 11 disabled" },
    { label: "Compiled size", value: "55,156 bytes<br>16 more than the reference" },
  ]}
>
