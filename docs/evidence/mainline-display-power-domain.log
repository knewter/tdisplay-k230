import json, subprocess
from pathlib import Path
p='/nix/store/nxbrd4smrcmknipjn4hjk32n87p4g9k6-k230-tdisplay-mainline-drm.dtb/k230-tdisplay-mainline-drm.dtb'
def get(node,prop,typ):
 return subprocess.check_output(['fdtget','-t',typ,p,node,prop],text=True).strip()
node='/soc/power-controller@91103000'
reg=get(node,'reg','x');cells=get(node,'#power-domain-cells','i');phandle=get(node,'phandle','x');consumer=get('/display-subsystem','power-domains','x')
assert reg=='0 91103000 0 1000' and cells=='1'
assert consumer.split()==[phandle,'2']
assert get(node,'compatible','s')=='canaan, k230-sysctl-power'
r=subprocess.run(['dtc','-I','dtb','-O','dts',p],text=True,capture_output=True,check=True)
Path('/home/jadams/tmp/mainline-genpd-roundtrip.dts').write_text(r.stdout)
print(json.dumps({'provider':node,'reg':reg,'cells':cells,'phandle':phandle,'display_power_domains':consumer,'roundtrip_warnings':r.stderr},indent=2))

